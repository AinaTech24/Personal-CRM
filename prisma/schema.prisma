generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------- Core / Auth ----------

enum Role {
  SUPER_ADMIN
  ADMIN
  DEPARTMENT_USER
}

model Department {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users           User[]
  leads           Lead[]
  projects        Project[]
  quotations      Quotation[]
  invoices        Invoice[]
  invites         Invite[]
  passwordEntries PasswordEntry[]
}

model User {
  id                    String      @id @default(cuid())
  email                 String      @unique
  passwordHash          String
  name                  String
  surname               String?
  // @unique with a nullable String is fine in MySQL — any number of NULL rows
  // are allowed, only two rows sharing the same non-null value would collide.
  mobile                String?     @unique
  // Date of birth, set by an admin. Only month/day are shown to colleagues
  // (see /api/birthdays); the year stays admin-only.
  birthday              DateTime?   @db.Date
  avatarDataUrl         String?     @db.LongText
  role                  Role        @default(DEPARTMENT_USER)
  departmentId          String?
  department            Department? @relation(fields: [departmentId], references: [id])
  isActive              Boolean     @default(true)
  resetCode             String? // bcrypt hash of the email login/reset code
  resetCodeExpiresAt    DateTime?
  // Alternate sign-in: mobile number + 6-digit PIN, alongside email+password.
  // Never required — null until the user (or an admin) sets one.
  pinHash               String? // bcrypt hash of the 6-digit PIN
  pinResetCode          String? // bcrypt hash of the mobile-based PIN-reset OTP
  pinResetCodeExpiresAt DateTime?

  // Preferences
  // Fixed app-wide (Asia/Kolkata), not user-editable. Left nullable on purpose:
  // making it required would fail db push against rows that predate the column,
  // and db push runs during the build — a failed push blocks the deploy.
  timezone           String? @default("Asia/Kolkata")
  locale             String  @default("en")
  defaultLandingPage String? // e.g. "/leads" — null means the Dashboard default
  density            String  @default("comfortable") // "comfortable" | "compact"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitesSent       Invite[]                 @relation("InvitedBy")
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  sessions          Session[]

  leadsCreated   Lead[]         @relation("LeadCreatedBy")
  leadsAssigned  Lead[]         @relation("LeadAssignedTo")
  leadNotes      LeadNote[]
  leadActivities LeadActivity[]
  leadReminders  LeadReminder[]

  tasksCreated    Task[]           @relation("TaskCreatedBy")
  tasksAssigned   Task[]           @relation("TaskAssignedTo")
  taskComments    TaskComment[]
  taskAttachments TaskAttachment[]

  projectsCreated        Project[]          @relation("ProjectCreatedBy")
  projectsAssigned       Project[]          @relation("ProjectAssignedTo")
  projectMemberships     ProjectMember[]
  projectDocuments       ProjectDocument[]
  projectActivities      ProjectActivity[]
  projectTasksAssigned   ProjectTask[]      @relation("ProjectTaskAssignedTo")
  projectTasksAssignedBy ProjectTask[]      @relation("ProjectTaskAssignedBy")
  projectTasksCreated    ProjectTask[]      @relation("ProjectTaskCreatedBy")
  projectSupporting      ProjectSupporter[] @relation("ProjectSupporter")
  projectTimeEntries     ProjectTimeEntry[] @relation("ProjectTimeEntryUser")
  projectTimeLogged      ProjectTimeEntry[] @relation("ProjectTimeEntryCreatedBy")

  quotationsCreated  Quotation[]         @relation("QuotationCreatedBy")
  quotationApprovals QuotationApproval[]

  invoicesCreated  Invoice[] @relation("InvoiceCreatedBy")
  paymentsRecorded Payment[]

  leaves             UserLeave[]        @relation("UserLeaves")
  leaveRequests      LeaveRequest[]     @relation("LeaveRequestUser")
  leaveDecisions     LeaveRequest[]     @relation("LeaveRequestDecider")
  clientsCreated     Client[]           @relation("ClientCreatedBy")
  clientTeamRoles    ClientTeamMember[] @relation("ClientTeamMemberUser")
  birthdayGifts      BirthdayGift[]     @relation("BirthdayGiftFor")
  attendance         Attendance[]       @relation("AttendanceUser")
  attendanceApproved Attendance[]       @relation("AttendanceApprover")
  attendanceAudits   AttendanceAudit[]  @relation("AttendanceAuditActor")

  meetingsOrganized Meeting[] @relation("MeetingOrganizer")
  meetingsAttending Meeting[] @relation("MeetingAttendees")

  conversationsCreated    Conversation[]       @relation("ConversationCreatedBy")
  conversationMemberships ConversationMember[]
  messagesSent            Message[]            @relation("MessageSender")
  messageReactions        MessageReaction[]    @relation("MessageReactionUser")
  pushSubscriptions       PushSubscription[]
  auditLogs               AuditLog[]           @relation("AuditActor")

  crmMembership                    CrmMember?
  callsOwned                       Call[]                      @relation("CallOwner")
  callsCreated                     Call[]                      @relation("CallCreatedBy")
  socialMediaMembership            SocialMediaMember?
  socialClientsCreated             SocialClient[]              @relation("SocialClientCreatedBy")
  socialClientsAssigned            SocialClient[]              @relation("SocialClientAssignedTo")
  socialContentCreated             SocialContentItem[]         @relation("SocialContentCreatedBy")
  socialContentUpdated             SocialContentItem[]         @relation("SocialContentUpdatedBy")
  socialContentApprovals           SocialContentApproval[]
  socialAdsCreated                 SocialAdCampaign[]          @relation("SocialAdCreatedBy")
  socialAdsUpdated                 SocialAdCampaign[]          @relation("SocialAdUpdatedBy")
  socialReportsCreated             SocialMonthlyReport[]       @relation("SocialReportCreatedBy")
  socialReportsUpdated             SocialMonthlyReport[]       @relation("SocialReportUpdatedBy")
  socialReportFilesUploaded        SocialReportFile[]          @relation("SocialReportFileUploadedBy")
  socialClientActivities           SocialClientActivity[]
  socialPlatformsCreated           SocialPlatformAccount[]     @relation("SocialPlatformCreatedBy")
  socialPlatformsUpdated           SocialPlatformAccount[]     @relation("SocialPlatformUpdatedBy")
  socialPlatformCredentialsUpdated SocialPlatformAccount[]     @relation("SocialPlatformCredentialsUpdatedBy")
  socialCalendarSlotsCreated       SocialContentCalendarSlot[] @relation("SocialCalendarSlotCreatedBy")
  socialClientFoldersCreated       SocialClientFolder[]        @relation("SocialClientFolderCreatedBy")
  socialClientImagesUploaded       SocialClientImage[]         @relation("SocialClientImageUploadedBy")
  passwordEntriesCreated           PasswordEntry[]             @relation("PasswordEntryCreatedBy")
  passwordEntriesUpdated           PasswordEntry[]             @relation("PasswordEntryUpdatedBy")
  passwordSharesReceived           PasswordEntryShare[]        @relation("PasswordEntrySharedWith")
  passwordSharesGiven              PasswordEntryShare[]        @relation("PasswordEntrySharedBy")
  passwordEntryActivities          PasswordEntryActivity[]
}

/// A browser/device push endpoint, so a user can be notified about a new
/// message while the app is closed. One row per device — the same person on a
/// phone and a laptop has two, and each can expire independently.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The push service URL. Unique because re-subscribing on the same device
  /// returns the same endpoint, and we want an upsert rather than a duplicate.
  /// VarChar, not Text: MySQL can't build a unique index on TEXT without a
  /// prefix length, and 500 stays under InnoDB's 3072-byte key limit.
  endpoint String @unique @db.VarChar(500)
  p256dh   String @db.Text
  auth     String @db.Text

  /// Labels the row in Settings so a user can tell their devices apart.
  userAgent  String?   @db.Text
  createdAt  DateTime  @default(now())
  /// Cleared out when the push service reports the endpoint is dead (404/410).
  lastUsedAt DateTime?

  @@index([userId])
}

model Invite {
  id                String      @id @default(cuid())
  email             String
  role              Role
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id])
  /// "Social Media (Admin)" in the invite Role picker isn't a real company
  /// Role — the account is still created as DEPARTMENT_USER, this just tells
  /// acceptance to also provision a SocialMediaMember(isLead: true) row, so
  /// full social-media access is granted the moment they accept rather than
  /// needing a separate admin step afterward.
  socialMediaAdmin  Boolean     @default(false)
  /// Same idea as socialMediaAdmin, but for a regular (non-lead) team member —
  /// provisions SocialMediaMember(isLead: false) on acceptance instead.
  /// Mutually exclusive with socialMediaAdmin in practice, not enforced here.
  socialMediaMember Boolean     @default(false)
  /// Same idea as socialMediaAdmin/socialMediaMember, but provisions a
  /// CrmMember row on acceptance instead — the CRM Team's equivalent.
  crmAdmin          Boolean     @default(false)
  crmMember         Boolean     @default(false)
  token             String      @unique
  invitedById       String
  invitedBy         User        @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt         DateTime
  acceptedAt        DateTime?
  createdAt         DateTime    @default(now())

  @@index([email])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/**
 * Per-user, per-category in-app notification toggle. Missing row = enabled (default-on).
 */
model NotificationPreference {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String // "leads" | "tasks" | "projects" | "quotations"
  inApp    Boolean @default(true)

  @@unique([userId, category])
}

/**
 * A logged-in session/device. The JWT carries this row's id as its `sid` claim,
 * so revoking here (revokedAt) invalidates that cookie immediately, even before
 * it expires — otherwise a JWT has no server-side kill switch.
 */
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

// ---------- Leads ----------

enum LeadStatus {
  NEW
  CONTACTED
  /// Social Media's custom pipeline only (see SOCIAL_MEDIA_LEAD_STATUSES in
  /// src/components/leads/types.ts) — other departments never see or pick
  /// this value, but it lives in the same shared Lead table/enum as everyone
  /// else's leads.
  MEETING
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MeetingStatus {
  SCHEDULED
  DUE
  COMPLETED
}

model Lead {
  id                  String         @id @default(cuid())
  name                String
  company             String?
  email               String?
  phone               String?
  source              String?
  product             String?
  priority            Priority       @default(MEDIUM)
  status              LeadStatus     @default(NEW)
  leadArriveDate      DateTime?
  meetingDate         DateTime?
  meetingStatus       MeetingStatus?
  assignedToId        String?
  assignedTo          User?          @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  departmentId        String?
  department          Department?    @relation(fields: [departmentId], references: [id])
  createdById         String
  createdBy           User           @relation("LeadCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  /// Set once, the first time a Social Media team member moves this lead to
  /// "Approval" (WON) — auto-creates a SocialClient and records its id here
  /// so re-saving the same status never creates a second client. Not a
  /// Prisma relation on purpose: Lead and SocialClient are otherwise
  /// unrelated domains, this is just a soft pointer for the redirect/link.
  convertedToClientId String?

  notes      LeadNote[]
  activities LeadActivity[]
  reminders  LeadReminder[]
  quotations Quotation[]
  calls      Call[]

  @@index([status])
  @@index([departmentId])
  @@index([assignedToId])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  meta      Json?
  createdAt DateTime @default(now())
}

model LeadReminder {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dueAt       DateTime
  note        String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

// ---------- Tasks ----------

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

model Task {
  id                  String       @id @default(cuid())
  title               String
  description         String?      @db.Text
  status              TaskStatus   @default(TODO)
  priority            Priority     @default(MEDIUM)
  dueDate             DateTime?
  assignedToId        String?
  assignedTo          User?        @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdById         String
  createdBy           User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  projectTaskParentId String?      @unique
  projectTaskParent   ProjectTask? @relation(fields: [projectTaskParentId], references: [id])
  /// When set, a cron-driven route notifies whoever this task is assigned to
  /// (toast/bell + OS push) once this time passes — see send-reminders/route.ts.
  /// Independent of dueDate — a reminder isn't required to line up with it.
  remindAt            DateTime?
  /// Set once the reminder actually fires, so the cron never re-sends the
  /// same one. Cleared automatically if remindAt is changed to a new value.
  reminderSentAt      DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([status])
  @@index([assignedToId])
  @@index([remindAt])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  data         String?  @db.LongText // base64-encoded file bytes stored in MySQL
  /// Set when this is a link rather than an uploaded file; `data` is then null
  /// and `fileName` holds the label. An explicit column rather than sniffing
  /// filePath for "http", so the two kinds can never be confused.
  url          String?  @db.Text
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

// ---------- Projects ----------

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id           String        @id @default(cuid())
  name         String
  description  String?       @db.Text
  departmentId String
  department   Department    @relation(fields: [departmentId], references: [id])
  status       ProjectStatus @default(PLANNED)
  progress     Int           @default(0)
  isActive     Boolean       @default(true)
  startDate    DateTime?
  endDate      DateTime?
  createdById  String
  createdBy    User          @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?         @relation("ProjectAssignedTo", fields: [assignedToId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  /// Hours the project was budgeted for, so logged time can be read against a
  /// plan rather than in isolation. Optional — a project may have no estimate.
  estimatedHours Int?

  members     ProjectMember[]
  supporters  ProjectSupporter[]
  timeEntries ProjectTimeEntry[]
  milestones  Milestone[]
  tasks       ProjectTask[]
  documents   ProjectDocument[]
  activities  ProjectActivity[]

  @@index([departmentId])
  @@index([status])
}

/// Someone who contributes to a project without being on its team: a reviewer,
/// a specialist pulled in for a week, another department's lead. Kept separate
/// from ProjectMember so team headcount and access rules stay unaffected.
model ProjectSupporter {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ProjectSupporter", fields: [userId], references: [id])
  /// What they support with, e.g. "Security review". Free text, not a role enum.
  role      String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
}

/// One person's work on one day. Stored per day rather than as start/stop
/// timestamps: the CRM records effort after the fact, and a day is the unit
/// people actually report in.
model ProjectTimeEntry {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("ProjectTimeEntryUser", fields: [userId], references: [id])
  /// Date-only: two entries on the same day are separate rows, not merged, so
  /// their descriptions survive.
  workDate    DateTime @db.Date
  /// Minutes, not fractional hours — decimal hours accumulate rounding error
  /// across a sum, and "1h 20m" has no exact float representation.
  minutes     Int
  description String?  @db.Text
  createdById String
  createdBy   User     @relation("ProjectTimeEntryCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, workDate])
  @@index([userId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

enum MilestoneStatus {
  PENDING
  WORKING
  DONE
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime?
  status      MilestoneStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  tasks ProjectTask[]
}

model ProjectTask {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId  String?
  milestone    Milestone?    @relation(fields: [milestoneId], references: [id])
  title        String
  description  String?       @db.Text
  status       TaskStatus    @default(TODO)
  dueDate      DateTime?
  progressPct  Int           @default(0)
  assignedToId String?
  assignedTo   User?         @relation("ProjectTaskAssignedTo", fields: [assignedToId], references: [id])
  /// Who the work is attributed to as having assigned it. Defaults to whoever
  /// filled the form, but is editable: an admin often raises a task on a
  /// manager's behalf, and the manager is the one who actually assigned it.
  assignedById String?
  assignedBy   User?         @relation("ProjectTaskAssignedBy", fields: [assignedById], references: [id])
  /// Who actually submitted the form. Never editable, so changing `assignedBy`
  /// can't erase the record of who really created the task. Nullable only
  /// because tasks predating this field have no one to credit.
  createdById  String?
  createdBy    User?         @relation("ProjectTaskCreatedBy", fields: [createdById], references: [id])
  parentTaskId String?
  parentTask   ProjectTask?  @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks     ProjectTask[] @relation("SubTasks")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  linkedTask Task?
  dependsOn  ProjectTaskDependency[] @relation("DependentTask")
  dependents ProjectTaskDependency[] @relation("DependsOnTask")

  @@index([projectId])
  @@index([status])
  @@index([assignedToId])
}

model ProjectTaskDependency {
  id            String      @id @default(cuid())
  taskId        String
  task          ProjectTask @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId   String
  dependsOnTask ProjectTask @relation("DependsOnTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

model ProjectDocument {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  data         String?  @db.LongText // base64-encoded file bytes stored in MySQL
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model ProjectActivity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  meta      Json?
  createdAt DateTime @default(now())
}

// ---------- Quotations ----------

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

model Quotation {
  id                     String          @id @default(cuid())
  quotationNumber        String          @unique
  clientName             String
  clientEmail            String?
  leadId                 String?
  lead                   Lead?           @relation(fields: [leadId], references: [id])
  status                 QuotationStatus @default(DRAFT)
  subtotal               Decimal         @default(0) @db.Decimal(12, 2)
  gstAmount              Decimal         @default(0) @db.Decimal(12, 2)
  discount               Decimal         @default(0) @db.Decimal(12, 2)
  total                  Decimal         @default(0) @db.Decimal(12, 2)
  validUntil             DateTime?
  clientAddress          String?         @db.Text
  clientGstin            String?
  shipToAddress          String?         @db.Text
  shipToGstin            String?
  placeOfSupply          String?
  subject                String?
  notes                  String?         @db.Text
  sellerName             String?
  sellerAddress          String?         @db.Text
  sellerGstin            String?
  sellerPhone            String?
  sellerEmail            String?
  sellerWebsite          String?
  sellerSignatory        String?
  sellerLogoDataUrl      String?         @db.LongText
  sellerSignatureDataUrl String?         @db.LongText
  createdById            String
  createdBy              User            @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  departmentId           String?
  department             Department?     @relation(fields: [departmentId], references: [id])
  currentVersion         Int             @default(1)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  items     QuotationItem[]
  versions  QuotationVersion[]
  approvals QuotationApproval[]
  invoices  Invoice[]

  @@index([status])
  @@index([departmentId])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  hsnSac      String?
  qty         Decimal   @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal   @db.Decimal(12, 2)
  gstRate     Decimal   @default(18) @db.Decimal(5, 2)
  lineTotal   Decimal   @db.Decimal(12, 2)
}

model QuotationVersion {
  id            String    @id @default(cuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  versionNumber Int
  snapshot      Json
  createdAt     DateTime  @default(now())

  @@unique([quotationId, versionNumber])
}

model QuotationApproval {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  approverId  String
  approver    User      @relation(fields: [approverId], references: [id])
  decision    String
  comment     String?   @db.Text
  decidedAt   DateTime  @default(now())
}

// ---------- Invoices ----------

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIAL_PAYMENT
  OVERDUE
  CANCELLED
}

model Invoice {
  id                     String        @id @default(cuid())
  invoiceNumber          String        @unique
  quotationId            String?
  quotation              Quotation?    @relation(fields: [quotationId], references: [id])
  clientName             String
  clientEmail            String?
  clientAddress          String?       @db.Text
  clientGstin            String?
  shipToAddress          String?       @db.Text
  shipToGstin            String?
  invoiceDate            DateTime      @default(now())
  terms                  String?
  poNumber               String?
  placeOfSupply          String?
  subject                String?
  notes                  String?       @db.Text
  sellerName             String?
  sellerAddress          String?       @db.Text
  sellerGstin            String?
  sellerPhone            String?
  sellerEmail            String?
  sellerWebsite          String?
  sellerSignatory        String?
  sellerLogoDataUrl      String?       @db.LongText
  sellerSignatureDataUrl String?       @db.LongText
  status                 InvoiceStatus @default(DRAFT)
  subtotal               Decimal       @default(0) @db.Decimal(12, 2)
  gstAmount              Decimal       @default(0) @db.Decimal(12, 2)
  total                  Decimal       @default(0) @db.Decimal(12, 2)
  dueDate                DateTime?
  createdById            String
  createdBy              User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  departmentId           String?
  department             Department?   @relation(fields: [departmentId], references: [id])
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([status])
  @@index([departmentId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  hsnSac      String?
  qty         Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  gstRate     Decimal @default(18) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
}

/**
 * Single-row seller profile used as the header on printed invoices/quotations.
 */
model CompanyProfile {
  id               String   @id @default("default")
  name             String   @default("")
  addressLines     String?  @db.Text
  gstin            String?
  phone            String?
  email            String?
  website          String?
  signatoryName    String?
  logoDataUrl      String?  @db.LongText
  signatureDataUrl String?  @db.LongText
  updatedAt        DateTime @updatedAt
}

/**
 * Single-row SMTP configuration for outgoing mail (invites, etc.).
 */
/**
 * App-level settings an admin can change without a redeploy. Single row, id "default".
 * Only for values that are genuinely runtime config — infrastructure secrets stay in
 * the environment: DATABASE_URL is needed to reach this table in the first place, and
 * JWT_SECRET is read by proxy.ts on the edge, where there's no database connection.
 */
model AppSettings {
  id            String   @id @default("default")
  /**
   * Base URL used to build links in outbound email. Falls back to APP_URL when unset.
   */
  appUrl        String?
  /**
   * Sidebar module keys hidden from non-admin users (e.g. ["quotations","invoices"]).
   * Admins always see every module. Null/absent = nothing hidden.
   */
  hiddenModules Json?
  updatedAt     DateTime @updatedAt
}

model SmtpSettings {
  id                   String   @id @default("default")
  host                 String?
  port                 Int      @default(587)
  secure               Boolean  @default(false)
  username             String?
  password             String?
  fromEmail            String?
  fromName             String?  @default("Aina CRM")
  /**
   * When true, invites may be sent to public email providers (Gmail, Outlook,
   * iCloud, Yahoo) in addition to @ainatech.in. Off by default.
   */
  allowExternalInvites Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal  @db.Decimal(12, 2)
  method       String
  paidAt       DateTime @default(now())
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  note         String?
}

// ---------- Attendance ----------

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
}

enum AttendanceApproval {
  PENDING
  APPROVED
  REJECTED
}

enum HalfDayReason {
  LATE_ARRIVAL
  EARLY_DEPARTURE
  INSUFFICIENT_HOURS
  APPROVED_HALF_DAY
  MANUAL_ADJUSTMENT
  OTHER
}

/**
 * One record per user per day. `date` is a DATE (no time) representing the
 * Asia/Kolkata calendar day — the app is fixed to IST, so the day boundary is
 * derived from IST wall-clock and stored as UTC midnight of that day.
 * `calculatedStatus` is what the thresholds produced from worked minutes;
 * `status` is what's in effect. They differ only when an admin overrides, and
 * keeping both is the audit trail: "system said HALF_DAY, admin set PRESENT".
 * `status` is null until check-out (or an admin sets it) — a checked-in-but-not-
 * checked-out record has no finalized status and renders neutral, not absent.
 */
model Attendance {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime           @db.Date
  checkIn          DateTime?
  checkOut         DateTime?
  workedMinutes    Int?
  calculatedStatus AttendanceStatus?
  status           AttendanceStatus?
  statusOverride   Boolean            @default(false)
  overrideReason   String?
  halfDayReason    HalfDayReason?
  adminNote        String?
  approvalStatus   AttendanceApproval @default(PENDING)
  approvedById     String?
  approvedBy       User?              @relation("AttendanceApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  audits           AttendanceAudit[]

  @@unique([userId, date])
  @@index([date])
  @@index([userId, date])
  @@index([approvalStatus])
}

/**
 * Immutable trail of every admin action on a record: override, approve, reject, edit times.
 */
model AttendanceAudit {
  id           String            @id @default(cuid())
  attendanceId String
  attendance   Attendance        @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  actorId      String
  actor        User              @relation("AttendanceAuditActor", fields: [actorId], references: [id])
  action       String // "override" | "approve" | "reject" | "edit_times"
  fromStatus   AttendanceStatus?
  toStatus     AttendanceStatus?
  note         String?           @db.Text
  ip           String?
  userAgent    String?           @db.Text
  createdAt    DateTime          @default(now())

  @@index([attendanceId])
}

/**
 * Configurable classification thresholds and policy. Single row, id "default".
 */
enum LeaveType {
  FULL_DAY
  HALF_DAY
}

/// An approved absence. Full-day leave blocks check-in entirely; half-day leave
/// restricts the user to the half-day shift windows.
model UserLeave {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  type        LeaveType @default(FULL_DAY)
  reason      String?
  createdById String
  createdAt   DateTime  @default(now())

  @@unique([userId, date])
  @@index([date])
}

model AttendanceSettings {
  id                   String   @id @default("default")
  /**
   * Admin-defined check-in/check-out windows, e.g.
   * [{ name, type: "FULL_DAY"|"HALF_DAY", checkInStart, checkInEnd, checkOutStart, checkOutEnd }]
   * with "HH:mm" IST times. Empty/absent means no time restriction.
   */
  shifts               Json?
  /**
   * Minutes worked to count as a full Present day. Default 8h.
   */
  fullDayMinutes       Int      @default(480)
  /**
   * Minutes worked to count as Half Day; below this is Absent. Default 4h.
   */
  halfDayMinutes       Int      @default(240)
  /**
   * When true, auto-classified records stay PENDING until an admin approves.
   */
  requireApproval      Boolean  @default(true)
  /**
   * When true, a Half Day can't be finalized without a halfDayReason.
   */
  requireHalfDayReason Boolean  @default(false)
  /**
   * JS getDay() numbers (0=Sun..6=Sat) that are working days. Default Mon–Sat.
   */
  workingWeekdays      String   @default("1,2,3,4,5,6")
  updatedAt            DateTime @updatedAt
}

/**
 * A non-working holiday, excluded from working days like Sundays are.
 */
model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

// ---------- Meetings ----------

enum MeetingState {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Meeting {
  id             String       @id @default(cuid())
  title          String
  description    String?      @db.Text
  /// Physical location or a video-call link.
  location       String?
  startsAt       DateTime
  endsAt         DateTime?
  status         MeetingState @default(SCHEDULED)
  organizerId    String
  organizer      User         @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  attendees      User[]       @relation("MeetingAttendees")
  /// When set, a cron-driven route notifies the organizer + every attendee
  /// (toast/bell + OS push) once this time passes — see send-reminders/route.ts.
  remindAt       DateTime?
  /// Set once the reminder actually fires, so the cron never re-sends the
  /// same one. Cleared automatically if remindAt is changed to a new value.
  reminderSentAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([startsAt])
  @@index([organizerId])
  @@index([remindAt])
}

// ---------- Chat / Messaging ----------

enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id           String           @id @default(cuid())
  type         ConversationType
  /// Group name; null for 1:1 direct chats.
  title        String?
  /// Group description, shown in Group info.
  description  String?          @db.Text
  /// Group avatar as a base64 data URL (same storage approach as user avatars).
  imageDataUrl String?          @db.LongText
  /// True for the auto-managed "Aina Family" group every user belongs to.
  isSystem     Boolean          @default(false)
  createdById  String?
  createdBy    User?            @relation("ConversationCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([type])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// When this member last opened the conversation — drives unread counts.
  lastReadAt     DateTime?
  /// Group admin: can rename the group, change its picture, and promote or
  /// demote other members. Separate from the CRM-wide Role — running a group
  /// says nothing about your authority anywhere else in the app.
  isGroupAdmin   Boolean      @default(false)
  /// When a temporary admin stops being one. Null means indefinite. Checked at
  /// read time rather than expired by a job — a job that fails would leave
  /// someone holding rights they were meant to lose.
  adminUntil     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  /// Quoted message this one replies to.
  replyToId String?
  replyTo   Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReply")

  /// Name of the original sender when this message was forwarded.
  forwardedFromName String?

  /// A notice the app wrote, not a person — someone joined, the group was
  /// renamed. Rendered as a centred capsule rather than a bubble, and never
  /// pinned, replied to or reacted to.
  isSystem Boolean @default(false)

  /// "Delete for everyone" — kept as a tombstone so the thread shows a placeholder.
  deletedForEveryone Boolean @default(false)

  pinnedAt   DateTime?
  pinnedById String?

  attachments MessageAttachment[]
  reactions   MessageReaction[]
  hiddenFor   MessageHidden[]

  @@index([conversationId, createdAt])
  @@index([replyToId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("MessageReactionUser", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

/// "Delete for me" — hides a message for one user without removing it for others.
model MessageHidden {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String
  size      Int
  /// base64 data URL stored in MySQL (images + documents only; no video).
  data      String   @db.LongText
  createdAt DateTime @default(now())

  @@index([messageId])
}

/// Every write in the CRM, recorded automatically.
///
/// Written by a Prisma extension rather than by each route, so a new endpoint
/// is covered the day it's added instead of the day someone remembers to log
/// from it.
model AuditLog {
  id        String   @id @default(cuid())
  /// Prisma model name — "Lead", "Task", "User"…
  model     String
  /// create | update | delete
  action    String
  /// Primary key of the affected row, when the operation exposes one.
  recordId  String?
  /// Human-readable summary, e.g. "Lead \"Acme Corp\" updated".
  summary   String   @db.Text
  /// The changed fields, as JSON. Null for deletes.
  changes   Json?
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([model, recordId])
  @@index([actorId])
}

// ---------- Social Media Management ----------
//
// Restricted to a specific team, not every department user — see
// SocialMediaMember and src/lib/social-media.ts. Company Admin/Super Admin
// always have full access without needing a membership row, same as every
// other module's isAdmin() override.

enum SocialClientStage {
  ENQUIRY
  CALLING
  MEETING
  PLAN_DISCUSSION
  APPROVAL
  ONBOARDED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  TWITTER
  YOUTUBE
}

enum SocialContentType {
  STATIC_POST
  CAROUSEL
  AI_REEL
  REAL_PERSON_REEL
}

/// The four fixed columns of the suggested monthly content calendar grid.
enum SocialCalendarWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// Upload/production status shown as colored text on a filled calendar
/// slot — green (DONE), orange (PENDING), red (NOT_UPLOADED, the default).
enum SocialCalendarSlotStatus {
  NOT_UPLOADED
  PENDING
  DONE
}

/// One shared enum across all four content types; each type's own ordered
/// subsequence lives in code (src/lib/social-content-workflow.ts), not here —
/// static post/carousel, AI reel, and real-person reel each walk a different
/// subset (e.g. only REAL_PERSON_REEL passes through CLIENT_CLIPS_RECEIVED and
/// EDITING; only the two reel types start at SCRIPT). DRAFT is legacy — kept
/// so old rows created before the per-type workflows still resolve to a
/// value, no longer used as a starting stage for new content.
enum SocialContentStage {
  DRAFT
  SCRIPT
  SCRIPT_APPROVED
  SHARED_IN_GROUP
  APPROVED_TO_PROCEED
  CLIENT_CLIPS_RECEIVED
  EDITING
  IN_PRODUCTION
  SHARED_FOR_REVIEW
  APPROVED_FINAL
  PUBLISHED
  CANCELLED
}

enum SocialAdObjective {
  LEADS
  REACH
  FOLLOWERS
}

enum SocialAdStage {
  DISCUSSION
  BUDGET_DURATION
  TARGETING
  CONTENT_APPROVAL
  AD_CREATION
  GROUP_APPROVAL
  CAMPAIGN_SETUP
  RUNNING
  REPORTING
  COMPLETED
  CANCELLED
}

/// Grants access to the Social Media module — presence of a row is the
/// access check itself (src/lib/social-media.ts). `isLead` sees and manages
/// every client instead of just their own.
model SocialMediaMember {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------- CRM Team ----------

/// The CRM Team's own membership roster — same shape as SocialMediaMember,
/// kept as a separate model rather than a shared "TeamMember" so each
/// module's scoping/permission logic stays independently simple, matching
/// how the rest of this schema already keeps Social Media's own models apart
/// from everyone else's.
model CrmMember {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum CallType {
  INCOMING
  OUTGOING
  MISSED
}

/// A call log entry for the CRM Team — who was called (a Lead, and/or a
/// free-text client name), when, by whom, and what's next. There's no
/// standalone "Client" entity outside Social Media's own SocialClient (see
/// the /clients page), so `clientName` is plain text rather than a relation —
/// building a whole new Client model wasn't part of this request.
model Call {
  id          String    @id @default(cuid())
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientName  String?
  callType    CallType
  startTime   DateTime
  endTime     DateTime?
  ownerId     String
  owner       User      @relation("CallOwner", fields: [ownerId], references: [id])
  /// What happens next — a follow-up call, an email, closing the deal, etc.
  nextAction  String?   @db.Text
  subject     String?
  description String?   @db.Text
  createdById String
  createdBy   User      @relation("CallCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([leadId])
  @@index([ownerId])
  @@index([startTime])
}

model SocialClient {
  id            String            @id @default(cuid())
  name          String
  companyName   String?
  contactPerson String?
  phone         String?
  email         String?
  stage         SocialClientStage @default(ENQUIRY)
  planNotes     String?           @db.Text
  approvedAt    DateTime?
  onboardedAt   DateTime?
  assignedToId  String?
  assignedTo    User?             @relation("SocialClientAssignedTo", fields: [assignedToId], references: [id])
  createdById   String
  createdBy     User              @relation("SocialClientCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  /// Manual drag-to-reorder position in the Clients folder grid. Shared
  /// across the team, not per-viewer; ties (the default 0) fall back to
  /// createdAt so unordered clients still sort consistently.
  folderOrder   Int               @default(0)

  platformAccounts SocialPlatformAccount[]
  contentItems     SocialContentItem[]
  adCampaigns      SocialAdCampaign[]
  monthlyReports   SocialMonthlyReport[]
  activities       SocialClientActivity[]
  calendarSlots    SocialContentCalendarSlot[]
  folders          SocialClientFolder[]

  @@index([stage])
  @@index([assignedToId])
}

/// A flat (single-level) folder for organizing a client's images — the
/// Files tab's own grouping, distinct from platform credentials/content/ads.
model SocialClientFolder {
  id          String       @id @default(cuid())
  clientId    String
  client      SocialClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  createdById String
  createdBy   User         @relation("SocialClientFolderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  images SocialClientImage[]

  @@index([clientId])
}

/// One uploaded image inside a SocialClientFolder — same base64-in-MySQL
/// upload shape as TaskAttachment/ProjectDocument/SocialReportFile.
model SocialClientImage {
  id           String             @id @default(cuid())
  folderId     String
  folder       SocialClientFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  data         String             @db.LongText
  uploadedById String
  uploadedBy   User               @relation("SocialClientImageUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([folderId])
}

/// Tracks which platforms are connected and whether login credentials have
/// been collected. `password` is stored as plain text, per explicit request —
/// no hashing or encryption here (unlike User.passwordHash/pinHash, which
/// stay one-way hashes since those are never meant to come back out).
model SocialPlatformAccount {
  id                     String         @id @default(cuid())
  clientId               String
  client                 SocialClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform               SocialPlatform
  handle                 String?
  credentialsReceived    Boolean        @default(false)
  password               String?        @db.Text
  credentialsUpdatedAt   DateTime?
  credentialsUpdatedById String?
  credentialsUpdatedBy   User?          @relation("SocialPlatformCredentialsUpdatedBy", fields: [credentialsUpdatedById], references: [id])
  notes                  String?        @db.Text
  createdById            String?
  createdBy              User?          @relation("SocialPlatformCreatedBy", fields: [createdById], references: [id])
  updatedById            String?
  updatedBy              User?          @relation("SocialPlatformUpdatedBy", fields: [updatedById], references: [id])
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@unique([clientId, platform])
}

/// One cell in the suggested monthly content calendar grid (4 weeks x
/// Monday/Wednesday/Friday/Saturday, per doc section 7). Deliberately a
/// lightweight planning entry, not a real SocialContentItem — this is a plan
/// slot ("Static #1", "Reel #2", or a freeform note like "Planning Meeting"),
/// independent of the Content tab's own DRAFT->PUBLISHED workflow. Display
/// numbering ("#N") is computed at render time from ordering (week, then
/// weekday) among same-contentType slots, not stored.
model SocialContentCalendarSlot {
  id           String                   @id @default(cuid())
  clientId     String
  client       SocialClient             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  year         Int
  month        Int
  week         Int
  weekday      SocialCalendarWeekday
  contentType  SocialContentType?
  /// Freeform label, only meaningful when contentType is null (e.g. "Planning Meeting").
  note         String?
  /// Overrides the auto-computed "#N" position within this month's same
  /// contentType (ordered by week/weekday) — null keeps the automatic order.
  manualNumber Int?
  status       SocialCalendarSlotStatus @default(NOT_UPLOADED)
  createdById  String
  createdBy    User                     @relation("SocialCalendarSlotCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([clientId, year, month, week, weekday])
  @@index([clientId, year, month])
}

/// One row per piece of content across all four workflows (static post,
/// carousel, AI reel, real-person reel). No assignedToId — visibility
/// follows the parent client's ownership, since a client's content is
/// worked on by whoever's covering that client, not assigned post-by-post.
model SocialContentItem {
  id           String             @id @default(cuid())
  clientId     String
  client       SocialClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type         SocialContentType
  title        String
  caption      String?            @db.Text
  hashtags     String?
  stage        SocialContentStage @default(DRAFT)
  /// Comma-separated SocialPlatform values — "publish on all platforms"
  /// means a single post can target more than one at once.
  platforms    String
  scheduledFor DateTime?
  publishedAt  DateTime?
  createdById  String
  createdBy    User               @relation("SocialContentCreatedBy", fields: [createdById], references: [id])
  updatedById  String?
  updatedBy    User?              @relation("SocialContentUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  approvals SocialContentApproval[]

  @@index([clientId])
  @@index([stage])
  @@index([type])
}

/// Append-only stage-transition log, same shape as QuotationApproval.
model SocialContentApproval {
  id        String             @id @default(cuid())
  contentId String
  content   SocialContentItem  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User               @relation(fields: [actorId], references: [id])
  fromStage SocialContentStage
  toStage   SocialContentStage
  comment   String?            @db.Text
  decidedAt DateTime           @default(now())
}

model SocialAdCampaign {
  id               String            @id @default(cuid())
  clientId         String
  client           SocialClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name             String
  objective        SocialAdObjective
  /// Comma-separated SocialPlatform values, same shape as
  /// SocialContentItem.platforms — null on ads created before this field.
  platforms        String?
  budget           Decimal?          @db.Decimal(12, 2)
  durationDays     Int?
  targetAudience   String?           @db.Text
  location         String?
  stage            SocialAdStage     @default(DISCUSSION)
  startedAt        DateTime?
  endedAt          DateTime?
  leadsGenerated   Int?
  reach            Int?
  cost             Decimal?          @db.Decimal(12, 2)
  ctr              Decimal?          @db.Decimal(5, 2)
  conversions      Int?
  retargetingNotes String?           @db.Text
  createdById      String
  createdBy        User              @relation("SocialAdCreatedBy", fields: [createdById], references: [id])
  updatedById      String?
  updatedBy        User?             @relation("SocialAdUpdatedBy", fields: [updatedById], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([clientId])
  @@index([stage])
}

model SocialMonthlyReport {
  id                     String       @id @default(cuid())
  clientId               String
  client                 SocialClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  year                   Int
  month                  Int
  title                  String?
  description            String?      @db.Text
  reach                  Int?
  engagement             Int?
  followersGained        Int?
  bestPosts              String?      @db.Text
  adSpend                Decimal?     @db.Decimal(12, 2)
  adLeads                Int?
  adCost                 Decimal?     @db.Decimal(12, 2)
  adCtr                  Decimal?     @db.Decimal(5, 2)
  adConversions          Int?
  insights               String?      @db.Text
  retargetingSuggestions String?      @db.Text
  nextMonthPlan          String?      @db.Text
  reviewedAt             DateTime?
  createdById            String
  createdBy              User         @relation("SocialReportCreatedBy", fields: [createdById], references: [id])
  updatedById            String?
  updatedBy              User?        @relation("SocialReportUpdatedBy", fields: [updatedById], references: [id])
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  files SocialReportFile[]

  @@unique([clientId, year, month])
}

/// One uploaded attachment on a monthly report — same base64-in-MySQL shape
/// as TaskAttachment/ProjectDocument. Multiple files per report; each can be
/// removed or replaced independently from the report form.
model SocialReportFile {
  id           String              @id @default(cuid())
  reportId     String
  report       SocialMonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  data         String              @db.LongText
  uploadedById String
  uploadedBy   User                @relation("SocialReportFileUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime            @default(now())

  @@index([reportId])
}

model SocialClientActivity {
  id        String       @id @default(cuid())
  clientId  String
  client    SocialClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User         @relation(fields: [actorId], references: [id])
  action    String
  meta      Json?
  createdAt DateTime     @default(now())

  @@index([clientId])
}

// ---------- Password Manager ----------

/// A stored credential. Visible by default only to users in the same
/// department (departmentId), plus anyone it's been explicitly shared with
/// via PasswordEntryShare — admins/super admins see every entry regardless
/// of department. `password` is stored as plain text, per explicit request
/// — same as SmtpSettings.password and SocialPlatformAccount.password
/// elsewhere in this schema — but is still never selected into a list
/// response or the generic audit trail (see AUDIT_IGNORED_MODELS in
/// src/lib/audit.ts); only the reveal endpoint ever returns it, and every
/// call there is logged.
model PasswordEntry {
  id             String  @id @default(cuid())
  label          String
  description    String? @db.Text
  link           String?
  username       String?
  password       String  @db.Text
  /// Fetched once from a trusted favicon service (never the stored link
  /// itself, so this never makes an outbound request to a user-supplied
  /// host) — lets an entry be recognized at a glance in the list.
  faviconDataUrl String? @db.LongText

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  createdById String
  createdBy   User    @relation("PasswordEntryCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("PasswordEntryUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shares     PasswordEntryShare[]
  activities PasswordEntryActivity[]

  @@index([departmentId])
}

/// Grants one specific user access to one specific entry, independent of
/// their department — the "share with another user" escape hatch on top of
/// the department-default visibility above.
model PasswordEntryShare {
  id              String        @id @default(cuid())
  passwordEntryId String
  passwordEntry   PasswordEntry @relation(fields: [passwordEntryId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation("PasswordEntrySharedWith", fields: [userId], references: [id])
  sharedById      String
  sharedBy        User          @relation("PasswordEntrySharedBy", fields: [sharedById], references: [id])
  createdAt       DateTime      @default(now())

  @@unique([passwordEntryId, userId])
  @@index([userId])
}

/// Purpose-built activity log for one entry — created/updated/shared/
/// unshared/revealed — kept separate from the generic AuditLog so a
/// credential's access history (who revealed it, and when) is always
/// available without ever risking the secret value itself landing in a
/// general-purpose log. Never records the password.
model PasswordEntryActivity {
  id              String        @id @default(cuid())
  passwordEntryId String
  passwordEntry   PasswordEntry @relation(fields: [passwordEntryId], references: [id], onDelete: Cascade)
  actorId         String
  actor           User          @relation(fields: [actorId], references: [id])
  action          String
  meta            Json?
  createdAt       DateTime      @default(now())

  @@index([passwordEntryId])
  @@index([actorId])
}

// ---------- Leave requests ----------

enum LeaveCategory {
  CASUAL
  SICK
  EARNED
  UNPAID
  OTHER
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A team member's application for leave, awaiting an admin's decision. Approving
/// one is what writes the per-day UserLeave rows (and stamps attendance) that the
/// attendance module already understands; the request itself is the record of
/// who asked, why, and who decided when.
model LeaveRequest {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation("LeaveRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  category    LeaveCategory      @default(CASUAL)
  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date
  isHalfDay   Boolean            @default(false)
  /// Working days covered (Sundays/holidays excluded; 0.5 for a half day).
  /// Computed server-side at apply time, never trusted from the client.
  days        Float
  reason      String             @db.Text
  status      LeaveRequestStatus @default(PENDING)
  decidedById String?
  decidedBy   User?              @relation("LeaveRequestDecider", fields: [decidedById], references: [id])
  /// The "Action Date": when an admin approved/rejected, or the user cancelled.
  decidedAt   DateTime?
  adminNote   String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, startDate])
  @@index([status])
}

// ---------- Client accounts (admin) ----------

enum ClientCategory {
  CRM
  WEBSITE
  WHATSAPP
  SMM
  DDQ
}

/// A company we sell a product to. Distinct from SocialClient, which is the
/// Social Media team's day-to-day working record.
model Client {
  id            String             @id @default(cuid())
  name          String
  category      ClientCategory
  /// Why the client came to us / what they bought the product for.
  reason        String?            @db.Text
  ownerName     String
  mobile        String?
  email         String?
  ownerBirthday DateTime?          @db.Date
  /// The product's contract window.
  productStart  DateTime?          @db.Date
  productEnd    DateTime?          @db.Date
  createdById   String
  createdBy     User               @relation("ClientCreatedBy", fields: [createdById], references: [id])
  team          ClientTeamMember[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([category])
}

model ClientTeamMember {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation("ClientTeamMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Free text, e.g. "Developer", "Account manager".
  role     String

  @@unique([clientId, userId])
}

// ---------- Birthday gifts ----------

/// The gift an admin has chosen for someone's birthday in a given year (the year
/// the birthday falls in, so a new year starts with no gift chosen). Free text:
/// Hamper / Cake / Plant are just the suggested options. Rows are kept after the
/// birthday, which is what makes the gift history.
model BirthdayGift {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("BirthdayGiftFor", fields: [userId], references: [id], onDelete: Cascade)
  year        Int
  gift        String   @db.VarChar(100)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, year])
}
