// ---------- Forms (generic form builder) ----------

enum FormFieldType {
  SHORT_TEXT
  LONG_TEXT
  EMAIL
  PHONE
  LINK
  PASSWORD
  NUMBER
  /// Like NUMBER, but the public page accepts fractional input (step="any")
  /// instead of whole numbers only. minValue/maxValue still apply, same
  /// Int columns as NUMBER — a decimal field can still have whole-number
  /// bounds even though the value entered within them can be fractional.
  DECIMAL
  /// Like NUMBER, formatted with a currency symbol (FormField.currencySymbol).
  CURRENCY
  DATE
  DROPDOWN
  RADIO
  CHECKBOX
  FILE_SINGLE
  FILE_MULTI
  SECTION_HEADING
  /// Layout-only, like SECTION_HEADING — splits the form into steps at the
  /// public page. Never has an answer.
  PAGE_BREAK
  /// A single-line text field (like SHORT_TEXT) whose `pattern` is set by
  /// the admin in the builder, not auto-applied from DEFAULT_FIELD_PATTERNS
  /// like EMAIL/PHONE/LINK — for a custom format no built-in type covers.
  REGEX
}

/// A form an admin built with the drag-and-drop builder (src/app/(dashboard)/forms).
/// Lives at the public, unauthenticated /f/[slug] — anyone with the link can submit
/// it, same as the Website Onboarding Form. `slug` is the public URL segment.
model Form {
  id           String      @id @default(cuid())
  title        String
  description  String?     @db.Text
  slug         String      @unique
  isActive     Boolean     @default(true)
  /// When false (the default), copying the link rotates it to a fresh
  /// random slug first — the old link stops working. Set true for a form
  /// whose link needs to stay stable, e.g. one embedded on a website.
  lockSlug     Boolean     @default(false)
  createdById  String
  createdBy    User        @relation("FormCreatedBy", fields: [createdById], references: [id])
  /// Which department this form was built for — distinct from
  /// viewerDepartments (who may see submissions). Nullable: forms created
  /// before this field existed have none until an admin sets one.
  departmentId String?
  department   Department? @relation("FormDepartment", fields: [departmentId], references: [id])

  /// Incremented once per page load at the public /f/[slug] URL — the
  /// denominator for the analytics conversion rate (submissions / views).
  /// A simple counter, not a per-visitor log: good enough to answer "is
  /// this form converting," not meant to dedupe repeat visits.
  viewCount Int @default(0)

  fields            FormField[]
  submissions       FormSubmission[]
  viewerDepartments FormViewerDepartment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Which departments besides Admins may view a given form's submissions —
/// mirrors the Website Onboarding Form's "Admins + Development" rule, but
/// configurable per form instead of hard-coded to one department.
model FormViewerDepartment {
  id           String     @id @default(cuid())
  formId       String
  form         Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([formId, departmentId])
}

model FormField {
  id          String        @id @default(cuid())
  formId      String
  form        Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  type        FormFieldType
  label       String
  placeholder String?
  helpText    String?       @db.Text
  required    Boolean       @default(false)
  /// Display order within the form — the builder's drag-and-drop reorders this.
  order       Int
  /// Pipe-separated choices for DROPDOWN/RADIO/CHECKBOX, e.g. "Red|Green|Blue".
  options     String?       @db.Text
  /// Character-length bounds, for text-like field types.
  minLength   Int?
  maxLength   Int?
  /// Value bounds, for NUMBER fields.
  minValue    Int?
  maxValue    Int?
  /// Regex source (no flags) a text-like answer must match, e.g. an EMAIL/PHONE shape.
  pattern     String?       @db.VarChar(500)
  /// CURRENCY only — the symbol shown before the amount, e.g. "$" or "₹". Null falls back to "₹" at render time.
  currencySymbol String?    @db.VarChar(10)

  /// Conditional logic — this field (and its validation/requiredness) is
  /// only in play when the field `conditionFieldId` points at currently
  /// satisfies `conditionOperator`/`conditionValue`. A soft pointer, not a
  /// relation, like the other cross-row ids in this file: a field that gets
  /// deleted should just stop gating anything, not take its dependents down
  /// with it. The builder only ever offers an earlier field (lower `order`)
  /// as the target, so evaluation in display order never has to look ahead.
  conditionFieldId  String?
  /// "equals" | "not_equals" | "contains" | "is_filled" | "is_empty"
  conditionOperator String?
  conditionValue    String? @db.Text

  answers     FormAnswer[]
  attachments FormAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formId, order])
}

/// One person's completed submission of a Form — the answers and attachments
/// belonging to it are separate rows (one per field) rather than a JSON blob,
/// so the admin table can be a straightforward join.
model FormSubmission {
  id     String @id @default(cuid())
  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  answers     FormAnswer[]
  attachments FormAttachment[]

  createdAt DateTime @default(now())

  /// Set once this submission has been turned into a Lead, so "Convert to
  /// Lead" shows as already-done instead of creating a second Lead from the
  /// same response. A soft pointer, not a relation — Lead is a separate
  /// domain this submission just happens to have fed once.
  convertedLeadId String?

  @@index([formId, createdAt])
}

model FormAnswer {
  id           String         @id @default(cuid())
  submissionId String
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fieldId      String
  field        FormField      @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  /// The answer as text; a CHECKBOX with multiple selections is pipe-separated,
  /// same convention as FormField.options.
  value        String         @db.Text

  @@index([submissionId])
  @@index([fieldId])
}

model FormAttachment {
  id           String         @id @default(cuid())
  submissionId String
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fieldId      String
  field        FormField      @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fileName     String
  data         String         @db.LongText

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([fieldId])
}

