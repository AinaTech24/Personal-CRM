  quotationId            String?
  quotation              Quotation?    @relation(fields: [quotationId], references: [id])
  clientName             String
  clientEmail            String?
  clientAddress          String?       @db.Text
  clientGstin            String?
  shipToAddress          String?       @db.Text
  shipToGstin            String?
  invoiceDate            DateTime      @default(now())
  terms                  String?
  poNumber               String?
  placeOfSupply          String?
  subject                String?
  notes                  String?       @db.Text
  sellerName             String?
  sellerAddress          String?       @db.Text
  sellerGstin            String?
  sellerPhone            String?
  sellerEmail            String?
  sellerWebsite          String?
  sellerSignatory        String?
  sellerLogoDataUrl      String?       @db.LongText
  sellerSignatureDataUrl String?       @db.LongText
  status                 InvoiceStatus @default(DRAFT)
