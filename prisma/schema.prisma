generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------- Core / Auth ----------

enum Role {
  SUPER_ADMIN
  ADMIN
  DEPARTMENT_USER
}

model Department {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users      User[]
  leads      Lead[]
  projects   Project[]
  quotations Quotation[]
  invoices   Invoice[]
  invites    Invite[]
}

model User {
  id                 String      @id @default(cuid())
  email              String      @unique
  passwordHash       String
  name               String
  surname            String?
  mobile             String?
  avatarDataUrl      String?     @db.LongText
  role               Role        @default(DEPARTMENT_USER)
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id])
  isActive           Boolean     @default(true)
  resetCode          String? // bcrypt hash of the email login/reset code
  resetCodeExpiresAt DateTime?

  // Preferences
  // Fixed app-wide (Asia/Kolkata), not user-editable. Left nullable on purpose:
  // making it required would fail db push against rows that predate the column,
  // and db push runs during the build — a failed push blocks the deploy.
  timezone           String? @default("Asia/Kolkata")
  locale             String  @default("en")
  defaultLandingPage String? // e.g. "/leads" — null means the Dashboard default
  density            String  @default("comfortable") // "comfortable" | "compact"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitesSent       Invite[]                 @relation("InvitedBy")
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  sessions          Session[]

  leadsCreated   Lead[]         @relation("LeadCreatedBy")
  leadsAssigned  Lead[]         @relation("LeadAssignedTo")
  leadNotes      LeadNote[]
  leadActivities LeadActivity[]
  leadReminders  LeadReminder[]

  tasksCreated    Task[]           @relation("TaskCreatedBy")
  tasksAssigned   Task[]           @relation("TaskAssignedTo")
  taskComments    TaskComment[]
  taskAttachments TaskAttachment[]

  projectsCreated      Project[]         @relation("ProjectCreatedBy")
  projectsAssigned     Project[]         @relation("ProjectAssignedTo")
  projectMemberships   ProjectMember[]
  projectDocuments     ProjectDocument[]
  projectActivities    ProjectActivity[]
  projectTasksAssigned ProjectTask[]     @relation("ProjectTaskAssignedTo")

  quotationsCreated  Quotation[]         @relation("QuotationCreatedBy")
  quotationApprovals QuotationApproval[]

  invoicesCreated  Invoice[] @relation("InvoiceCreatedBy")
  paymentsRecorded Payment[]

  leaves             UserLeave[]       @relation("UserLeaves")
  attendance         Attendance[]      @relation("AttendanceUser")
  attendanceApproved Attendance[]      @relation("AttendanceApprover")
  attendanceAudits   AttendanceAudit[] @relation("AttendanceAuditActor")

  meetingsOrganized Meeting[] @relation("MeetingOrganizer")
  meetingsAttending Meeting[] @relation("MeetingAttendees")

  conversationsCreated    Conversation[]       @relation("ConversationCreatedBy")
  conversationMemberships ConversationMember[]
  messagesSent            Message[]            @relation("MessageSender")
  messageReactions        MessageReaction[]    @relation("MessageReactionUser")
}

model Invite {
  id           String      @id @default(cuid())
  email        String
  role         Role
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  token        String      @unique
  invitedById  String
  invitedBy    User        @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime    @default(now())

  @@index([email])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/**
 * Per-user, per-category in-app notification toggle. Missing row = enabled (default-on).
 */
model NotificationPreference {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String // "leads" | "tasks" | "projects" | "quotations"
  inApp    Boolean @default(true)

  @@unique([userId, category])
}

/**
 * A logged-in session/device. The JWT carries this row's id as its `sid` claim,
 * so revoking here (revokedAt) invalidates that cookie immediately, even before
 * it expires — otherwise a JWT has no server-side kill switch.
 */
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

// ---------- Leads ----------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MeetingStatus {
  SCHEDULED
  DUE
  COMPLETED
}

model Lead {
  id             String         @id @default(cuid())
  name           String
  company        String?
  email          String?
  phone          String?
  source         String?
  product        String?
  priority       Priority       @default(MEDIUM)
  status         LeadStatus     @default(NEW)
  leadArriveDate DateTime?
  meetingDate    DateTime?
  meetingStatus  MeetingStatus?
  assignedToId   String?
  assignedTo     User?          @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id])
  createdById    String
  createdBy      User           @relation("LeadCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  notes      LeadNote[]
  activities LeadActivity[]
  reminders  LeadReminder[]
  quotations Quotation[]

  @@index([status])
  @@index([departmentId])
  @@index([assignedToId])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  meta      Json?
  createdAt DateTime @default(now())
}

model LeadReminder {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dueAt       DateTime
  note        String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

// ---------- Tasks ----------

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

model Task {
  id                  String       @id @default(cuid())
  title               String
  description         String?      @db.Text
  status              TaskStatus   @default(TODO)
  priority            Priority     @default(MEDIUM)
  dueDate             DateTime?
  assignedToId        String?
  assignedTo          User?        @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  createdById         String
  createdBy           User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  projectTaskParentId String?      @unique
  projectTaskParent   ProjectTask? @relation(fields: [projectTaskParentId], references: [id])
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([status])
  @@index([assignedToId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  data         String?  @db.LongText // base64-encoded file bytes stored in MySQL
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

// ---------- Projects ----------

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id           String        @id @default(cuid())
  name         String
  description  String?       @db.Text
  departmentId String
  department   Department    @relation(fields: [departmentId], references: [id])
  status       ProjectStatus @default(PLANNED)
  progress     Int           @default(0)
  isActive     Boolean       @default(true)
  startDate    DateTime?
  endDate      DateTime?
  createdById  String
  createdBy    User          @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?         @relation("ProjectAssignedTo", fields: [assignedToId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  members    ProjectMember[]
  milestones Milestone[]
  tasks      ProjectTask[]
  documents  ProjectDocument[]
  activities ProjectActivity[]

  @@index([departmentId])
  @@index([status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

enum MilestoneStatus {
  PENDING
  WORKING
  DONE
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime?
  status      MilestoneStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  tasks ProjectTask[]
}

model ProjectTask {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId  String?
  milestone    Milestone?    @relation(fields: [milestoneId], references: [id])
  title        String
  description  String?       @db.Text
  status       TaskStatus    @default(TODO)
  dueDate      DateTime?
  progressPct  Int           @default(0)
  assignedToId String?
  assignedTo   User?         @relation("ProjectTaskAssignedTo", fields: [assignedToId], references: [id])
  parentTaskId String?
  parentTask   ProjectTask?  @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks     ProjectTask[] @relation("SubTasks")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  linkedTask Task?
  dependsOn  ProjectTaskDependency[] @relation("DependentTask")
  dependents ProjectTaskDependency[] @relation("DependsOnTask")

  @@index([projectId])
  @@index([status])
  @@index([assignedToId])
}

model ProjectTaskDependency {
  id            String      @id @default(cuid())
  taskId        String
  task          ProjectTask @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId   String
  dependsOnTask ProjectTask @relation("DependsOnTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

model ProjectDocument {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  data         String?  @db.LongText // base64-encoded file bytes stored in MySQL
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model ProjectActivity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  meta      Json?
  createdAt DateTime @default(now())
}

// ---------- Quotations ----------

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

model Quotation {
  id                     String          @id @default(cuid())
  quotationNumber        String          @unique
  clientName             String
  clientEmail            String?
  leadId                 String?
  lead                   Lead?           @relation(fields: [leadId], references: [id])
  status                 QuotationStatus @default(DRAFT)
  subtotal               Decimal         @default(0) @db.Decimal(12, 2)
  gstAmount              Decimal         @default(0) @db.Decimal(12, 2)
  discount               Decimal         @default(0) @db.Decimal(12, 2)
  total                  Decimal         @default(0) @db.Decimal(12, 2)
  validUntil             DateTime?
  clientAddress          String?         @db.Text
  clientGstin            String?
  shipToAddress          String?         @db.Text
  shipToGstin            String?
  placeOfSupply          String?
  subject                String?
  notes                  String?         @db.Text
  sellerName             String?
  sellerAddress          String?         @db.Text
  sellerGstin            String?
  sellerPhone            String?
  sellerEmail            String?
  sellerWebsite          String?
  sellerSignatory        String?
  sellerLogoDataUrl      String?         @db.LongText
  sellerSignatureDataUrl String?         @db.LongText
  createdById            String
  createdBy              User            @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  departmentId           String?
  department             Department?     @relation(fields: [departmentId], references: [id])
  currentVersion         Int             @default(1)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  items     QuotationItem[]
  versions  QuotationVersion[]
  approvals QuotationApproval[]
  invoices  Invoice[]

  @@index([status])
  @@index([departmentId])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  hsnSac      String?
  qty         Decimal   @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal   @db.Decimal(12, 2)
  gstRate     Decimal   @default(18) @db.Decimal(5, 2)
  lineTotal   Decimal   @db.Decimal(12, 2)
}

model QuotationVersion {
  id            String    @id @default(cuid())
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  versionNumber Int
  snapshot      Json
  createdAt     DateTime  @default(now())

  @@unique([quotationId, versionNumber])
}

model QuotationApproval {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  approverId  String
  approver    User      @relation(fields: [approverId], references: [id])
  decision    String
  comment     String?   @db.Text
  decidedAt   DateTime  @default(now())
}

// ---------- Invoices ----------

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIAL_PAYMENT
  OVERDUE
  CANCELLED
}

model Invoice {
  id                     String        @id @default(cuid())
  invoiceNumber          String        @unique
  quotationId            String?
  quotation              Quotation?    @relation(fields: [quotationId], references: [id])
  clientName             String
  clientEmail            String?
  clientAddress          String?       @db.Text
  clientGstin            String?
  shipToAddress          String?       @db.Text
  shipToGstin            String?
  invoiceDate            DateTime      @default(now())
  terms                  String?
  poNumber               String?
  placeOfSupply          String?
  subject                String?
  notes                  String?       @db.Text
  sellerName             String?
  sellerAddress          String?       @db.Text
  sellerGstin            String?
  sellerPhone            String?
  sellerEmail            String?
  sellerWebsite          String?
  sellerSignatory        String?
  sellerLogoDataUrl      String?       @db.LongText
  sellerSignatureDataUrl String?       @db.LongText
  status                 InvoiceStatus @default(DRAFT)
  subtotal               Decimal       @default(0) @db.Decimal(12, 2)
  gstAmount              Decimal       @default(0) @db.Decimal(12, 2)
  total                  Decimal       @default(0) @db.Decimal(12, 2)
  dueDate                DateTime?
  createdById            String
  createdBy              User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  departmentId           String?
  department             Department?   @relation(fields: [departmentId], references: [id])
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([status])
  @@index([departmentId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  hsnSac      String?
  qty         Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  gstRate     Decimal @default(18) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
}

/**
 * Single-row seller profile used as the header on printed invoices/quotations.
 */
model CompanyProfile {
  id               String   @id @default("default")
  name             String   @default("")
  addressLines     String?  @db.Text
  gstin            String?
  phone            String?
  email            String?
  website          String?
  signatoryName    String?
  logoDataUrl      String?  @db.LongText
  signatureDataUrl String?  @db.LongText
  updatedAt        DateTime @updatedAt
}

/**
 * Single-row SMTP configuration for outgoing mail (invites, etc.).
 */
/**
 * App-level settings an admin can change without a redeploy. Single row, id "default".
 * Only for values that are genuinely runtime config — infrastructure secrets stay in
 * the environment: DATABASE_URL is needed to reach this table in the first place, and
 * JWT_SECRET is read by proxy.ts on the edge, where there's no database connection.
 */
model AppSettings {
  id        String   @id @default("default")
  /**
   * Base URL used to build links in outbound email. Falls back to APP_URL when unset.
   */
  appUrl    String?
  /**
   * Sidebar module keys hidden from non-admin users (e.g. ["quotations","invoices"]).
   * Admins always see every module. Null/absent = nothing hidden.
   */
  hiddenModules Json?
  updatedAt DateTime @updatedAt
}

model SmtpSettings {
  id        String   @id @default("default")
  host      String?
  port      Int      @default(587)
  secure    Boolean  @default(false)
  username  String?
  password  String?
  fromEmail String?
  fromName  String?  @default("Aina CRM")
  /**
   * When true, invites may be sent to public email providers (Gmail, Outlook,
   * iCloud, Yahoo) in addition to @ainatech.in. Off by default.
   */
  allowExternalInvites Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal  @db.Decimal(12, 2)
  method       String
  paidAt       DateTime @default(now())
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  note         String?
}

// ---------- Attendance ----------

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
}

enum AttendanceApproval {
  PENDING
  APPROVED
  REJECTED
}

enum HalfDayReason {
  LATE_ARRIVAL
  EARLY_DEPARTURE
  INSUFFICIENT_HOURS
  APPROVED_HALF_DAY
  MANUAL_ADJUSTMENT
  OTHER
}

/**
 * One record per user per day. `date` is a DATE (no time) representing the
 * Asia/Kolkata calendar day — the app is fixed to IST, so the day boundary is
 * derived from IST wall-clock and stored as UTC midnight of that day.
 * `calculatedStatus` is what the thresholds produced from worked minutes;
 * `status` is what's in effect. They differ only when an admin overrides, and
 * keeping both is the audit trail: "system said HALF_DAY, admin set PRESENT".
 * `status` is null until check-out (or an admin sets it) — a checked-in-but-not-
 * checked-out record has no finalized status and renders neutral, not absent.
 */
model Attendance {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime           @db.Date
  checkIn          DateTime?
  checkOut         DateTime?
  workedMinutes    Int?
  calculatedStatus AttendanceStatus?
  status           AttendanceStatus?
  statusOverride   Boolean            @default(false)
  overrideReason   String?
  halfDayReason    HalfDayReason?
  adminNote        String?
  approvalStatus   AttendanceApproval @default(PENDING)
  approvedById     String?
  approvedBy       User?              @relation("AttendanceApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  audits           AttendanceAudit[]

  @@unique([userId, date])
  @@index([date])
  @@index([userId, date])
  @@index([approvalStatus])
}

/**
 * Immutable trail of every admin action on a record: override, approve, reject, edit times.
 */
model AttendanceAudit {
  id           String            @id @default(cuid())
  attendanceId String
  attendance   Attendance        @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  actorId      String
  actor        User              @relation("AttendanceAuditActor", fields: [actorId], references: [id])
  action       String // "override" | "approve" | "reject" | "edit_times"
  fromStatus   AttendanceStatus?
  toStatus     AttendanceStatus?
  note         String?           @db.Text
  ip           String?
  userAgent    String?           @db.Text
  createdAt    DateTime          @default(now())

  @@index([attendanceId])
}

/**
 * Configurable classification thresholds and policy. Single row, id "default".
 */
enum LeaveType {
  FULL_DAY
  HALF_DAY
}

/// An approved absence. Full-day leave blocks check-in entirely; half-day leave
/// restricts the user to the half-day shift windows.
model UserLeave {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  type        LeaveType @default(FULL_DAY)
  reason      String?
  createdById String
  createdAt   DateTime  @default(now())

  @@unique([userId, date])
  @@index([date])
}

model AttendanceSettings {
  id                   String   @id @default("default")
  /**
   * Admin-defined check-in/check-out windows, e.g.
   * [{ name, type: "FULL_DAY"|"HALF_DAY", checkInStart, checkInEnd, checkOutStart, checkOutEnd }]
   * with "HH:mm" IST times. Empty/absent means no time restriction.
   */
  shifts               Json?
  /**
   * Minutes worked to count as a full Present day. Default 8h.
   */
  fullDayMinutes       Int      @default(480)
  /**
   * Minutes worked to count as Half Day; below this is Absent. Default 4h.
   */
  halfDayMinutes       Int      @default(240)
  /**
   * When true, auto-classified records stay PENDING until an admin approves.
   */
  requireApproval      Boolean  @default(true)
  /**
   * When true, a Half Day can't be finalized without a halfDayReason.
   */
  requireHalfDayReason Boolean  @default(false)
  /**
   * JS getDay() numbers (0=Sun..6=Sat) that are working days. Default Mon–Sat.
   */
  workingWeekdays      String   @default("1,2,3,4,5,6")
  updatedAt            DateTime @updatedAt
}

/**
 * A non-working holiday, excluded from working days like Sundays are.
 */
model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

// ---------- Meetings ----------

enum MeetingState {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Meeting {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  /// Physical location or a video-call link.
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  status      MeetingState @default(SCHEDULED)
  organizerId String
  organizer   User          @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  attendees   User[]        @relation("MeetingAttendees")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([startsAt])
  @@index([organizerId])
}

// ---------- Chat / Messaging ----------

enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id          String           @id @default(cuid())
  type        ConversationType
  /// Group name; null for 1:1 direct chats.
  title       String?
  /// True for the auto-managed "Aina Family" group every user belongs to.
  isSystem    Boolean          @default(false)
  createdById String?
  createdBy   User?            @relation("ConversationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([type])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// When this member last opened the conversation — drives unread counts.
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  /// Quoted message this one replies to.
  replyToId String?
  replyTo   Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReply")

  /// Name of the original sender when this message was forwarded.
  forwardedFromName String?

  /// "Delete for everyone" — kept as a tombstone so the thread shows a placeholder.
  deletedForEveryone Boolean @default(false)

  pinnedAt   DateTime?
  pinnedById String?

  attachments MessageAttachment[]
  reactions   MessageReaction[]
  hiddenFor   MessageHidden[]

  @@index([conversationId, createdAt])
  @@index([replyToId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("MessageReactionUser", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

/// "Delete for me" — hides a message for one user without removing it for others.
model MessageHidden {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String
  size      Int
  /// base64 data URL stored in MySQL (images + documents only; no video).
  data      String   @db.LongText
  createdAt DateTime @default(now())

  @@index([messageId])
}
