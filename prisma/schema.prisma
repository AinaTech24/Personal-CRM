// ---------- Invoices ----------

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIAL_PAYMENT
  OVERDUE
  CANCELLED
}

model Invoice {
  id                     String        @id @default(cuid())
  invoiceNumber          String        @unique
  quotationId            String?
  quotation              Quotation?    @relation(fields: [quotationId], references: [id])
  clientName             String
  clientEmail            String?
  clientAddress          String?       @db.Text
  clientGstin            String?
  shipToAddress          String?       @db.Text
  shipToGstin            String?
  invoiceDate            DateTime      @default(now())
  terms                  String?
  poNumber               String?
  placeOfSupply          String?
  subject                String?
  notes                  String?       @db.Text
  sellerName             String?
  sellerAddress          String?       @db.Text
  sellerGstin            String?
  sellerPhone            String?
  sellerEmail            String?
  sellerWebsite          String?
  sellerSignatory        String?
  sellerLogoDataUrl      String?       @db.LongText
  sellerSignatureDataUrl String?       @db.LongText
  status                 InvoiceStatus @default(DRAFT)
  subtotal               Decimal       @default(0) @db.Decimal(12, 2)
  gstAmount              Decimal       @default(0) @db.Decimal(12, 2)
  total                  Decimal       @default(0) @db.Decimal(12, 2)
  dueDate                DateTime?
  /// Set once the overdue reminder sweep has nagged this invoice's creator —
  /// cleared whenever dueDate is edited, so a new due date gets its own
  /// chance to be missed before nagging again.
  overdueReminderSentAt  DateTime?
  createdById            String
  createdBy              User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  departmentId           String?
