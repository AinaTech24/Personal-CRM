/// One person's completed submission of a Form — the answers and attachments
/// belonging to it are separate rows (one per field) rather than a JSON blob,
/// so the admin table can be a straightforward join.
model FormSubmission {
  id     String @id @default(cuid())
  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  answers     FormAnswer[]
  attachments FormAttachment[]

  createdAt DateTime @default(now())

  /// Set once this submission has been turned into a Lead, so "Convert to
  /// Lead" shows as already-done instead of creating a second Lead from the
  /// same response. A soft pointer, not a relation — Lead is a separate
  /// domain this submission just happens to have fed once.
  convertedLeadId String?

  @@index([formId, createdAt])
}

model FormAnswer {
  id           String         @id @default(cuid())
  submissionId String
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fieldId      String
  field        FormField      @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  /// The answer as text; a CHECKBOX with multiple selections is pipe-separated,
  /// same convention as FormField.options.
  value        String         @db.Text

  @@index([submissionId])
  @@index([fieldId])
}

model FormAttachment {
  id           String         @id @default(cuid())
  submissionId String
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fieldId      String
  field        FormField      @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  fileName     String
  data         String         @db.LongText

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([fieldId])
}

