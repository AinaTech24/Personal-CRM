model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  hsnSac      String?
  qty         Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  gstRate     Decimal @default(18) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
}

/**
 * Single-row seller profile used as the header on printed invoices/quotations.
 */
model CompanyProfile {
  id               String   @id @default("default")
  name             String   @default("")
  addressLines     String?  @db.Text
  gstin            String?
  phone            String?
  email            String?
  website          String?
  signatoryName    String?
  logoDataUrl      String?  @db.LongText
  signatureDataUrl String?  @db.LongText
  updatedAt        DateTime @updatedAt
}

/**
 * Single-row SMTP configuration for outgoing mail (invites, etc.).
 */
/**
 * App-level settings an admin can change without a redeploy. Single row, id "default".
 * Only for values that are genuinely runtime config — infrastructure secrets stay in
 * the environment: DATABASE_URL is needed to reach this table in the first place, and
 * JWT_SECRET is read by proxy.ts on the edge, where there's no database connection.
 */
model AppSettings {
  id            String   @id @default("default")
  /**
   * Base URL used to build links in outbound email. Falls back to APP_URL when unset.
   */
  appUrl        String?
  /**
   * Sidebar module keys hidden from non-admin users (e.g. ["quotations","invoices"]).
   * Admins always see every module. Null/absent = nothing hidden.
   */
  hiddenModules Json?
  updatedAt     DateTime @updatedAt
}

model SmtpSettings {
  id                   String   @id @default("default")
  host                 String?
  port                 Int      @default(587)
  secure               Boolean  @default(false)
  username             String?
  password             String?
  fromEmail            String?
  fromName             String?  @default("Aina CRM")
  /**
   * When true, invites may be sent to public email providers (Gmail, Outlook,
   * iCloud, Yahoo) in addition to @ainatech.in. Off by default.
   */
  allowExternalInvites Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal  @db.Decimal(12, 2)
  method       String
  paidAt       DateTime @default(now())
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  note         String?
}

// ---------- Attendance ----------

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
}

enum AttendanceApproval {
  PENDING
  APPROVED
  REJECTED
}

enum HalfDayReason {
  LATE_ARRIVAL
  EARLY_DEPARTURE
  INSUFFICIENT_HOURS
  APPROVED_HALF_DAY
  MANUAL_ADJUSTMENT
  OTHER
}

/**
 * One record per user per day. `date` is a DATE (no time) representing the
 * Asia/Kolkata calendar day — the app is fixed to IST, so the day boundary is
 * derived from IST wall-clock and stored as UTC midnight of that day.
 * `calculatedStatus` is what the thresholds produced from worked minutes;
 * `status` is what's in effect. They differ only when an admin overrides, and
 * keeping both is the audit trail: "system said HALF_DAY, admin set PRESENT".
 * `status` is null until check-out (or an admin sets it) — a checked-in-but-not-
 * checked-out record has no finalized status and renders neutral, not absent.
 */
model Attendance {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime           @db.Date
  checkIn          DateTime?
  checkOut         DateTime?
  /// Set while on an open break, cleared (and its length added to breakMinutes)
  /// on break-out — or auto-closed the same way at check-out, so a forgotten
  /// break never leaves this dangling. Supports more than one break a day:
  /// each break-in/break-out pair just adds its length to the running total.
  breakIn          DateTime?
  /// Cumulative break time today, in minutes — subtracted from the raw
  /// checkIn→checkOut span when workedMinutes is computed.
  breakMinutes     Int                @default(0)
  workedMinutes    Int?
  calculatedStatus AttendanceStatus?
  status           AttendanceStatus?
  statusOverride   Boolean            @default(false)
  overrideReason   String?
  halfDayReason    HalfDayReason?
  adminNote        String?
  approvalStatus   AttendanceApproval @default(PENDING)
  approvedById     String?
  approvedBy       User?              @relation("AttendanceApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  audits           AttendanceAudit[]

  @@unique([userId, date])
  @@index([date])
  @@index([userId, date])
  @@index([approvalStatus])
}

/**
 * Immutable trail of every admin action on a record: override, approve, reject, edit times.
 */
model AttendanceAudit {
  id           String            @id @default(cuid())
  attendanceId String
  attendance   Attendance        @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  actorId      String
  actor        User              @relation("AttendanceAuditActor", fields: [actorId], references: [id])
  action       String // "override" | "approve" | "reject" | "edit_times"
  fromStatus   AttendanceStatus?
  toStatus     AttendanceStatus?
  note         String?           @db.Text
  ip           String?
  userAgent    String?           @db.Text
  createdAt    DateTime          @default(now())

  @@index([attendanceId])
}

/**
 * Configurable classification thresholds and policy. Single row, id "default".
 */
enum LeaveType {
  FULL_DAY
  HALF_DAY
}

/// An approved absence. Full-day leave blocks check-in entirely; half-day leave
/// restricts the user to the half-day shift windows.
model UserLeave {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  type        LeaveType @default(FULL_DAY)
  reason      String?
  createdById String
  createdAt   DateTime  @default(now())

  @@unique([userId, date])
  @@index([date])
}

model AttendanceSettings {
  id                   String   @id @default("default")
  /**
   * Admin-defined check-in/check-out windows, e.g.
   * [{ name, type: "FULL_DAY"|"HALF_DAY", checkInStart, checkInEnd, checkOutStart, checkOutEnd }]
   * with "HH:mm" IST times. Empty/absent means no time restriction.
   */
  shifts               Json?
  /**
   * Minutes worked to count as a full Present day. Default 8h.
   */
  fullDayMinutes       Int      @default(480)
  /**
   * Minutes worked to count as Half Day; below this is Absent. Default 4h.
   */
  halfDayMinutes       Int      @default(240)
  /**
   * When true, auto-classified records stay PENDING until an admin approves.
   */
  requireApproval      Boolean  @default(true)
  /**
   * When true, a Half Day can't be finalized without a halfDayReason.
   */
  requireHalfDayReason Boolean  @default(false)
  /**
   * JS getDay() numbers (0=Sun..6=Sat) that are working days. Default Mon–Sat.
   */
  workingWeekdays      String   @default("1,2,3,4,5,6")
  updatedAt            DateTime @updatedAt
}

/**
 * A non-working holiday, excluded from working days like Sundays are.
 */
model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

// ---------- Meetings ----------

enum MeetingState {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Meeting {
  id             String       @id @default(cuid())
  title          String
  description    String?      @db.Text
  /// Physical location or a video-call link.
  location       String?
  startsAt       DateTime
  endsAt         DateTime?
  status         MeetingState @default(SCHEDULED)
  organizerId    String
  organizer      User         @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  attendees      User[]       @relation("MeetingAttendees")
  /// When set, a cron-driven route notifies the organizer + every attendee
  /// (toast/bell + OS push) once this time passes — see send-reminders/route.ts.
  remindAt       DateTime?
  /// Set once the reminder actually fires, so the cron never re-sends the
  /// same one. Cleared automatically if remindAt is changed to a new value.
  reminderSentAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([startsAt])
  @@index([organizerId])
  @@index([remindAt])
}

// ---------- Chat / Messaging ----------

enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id           String           @id @default(cuid())
  type         ConversationType
  /// Group name; null for 1:1 direct chats.
  title        String?
  /// Group description, shown in Group info.
  description  String?          @db.Text
  /// Group avatar as a base64 data URL (same storage approach as user avatars).
  imageDataUrl String?          @db.LongText
  /// True for the auto-managed "Aina Family" group every user belongs to.
  isSystem     Boolean          @default(false)
  createdById  String?
  createdBy    User?            @relation("ConversationCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  members  ConversationMember[]
  messages Message[]

  @@index([type])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// When this member last opened the conversation — drives unread counts.
  lastReadAt     DateTime?
  /// Group admin: can rename the group, change its picture, and promote or
  /// demote other members. Separate from the CRM-wide Role — running a group
  /// says nothing about your authority anywhere else in the app.
  isGroupAdmin   Boolean      @default(false)
  /// When a temporary admin stops being one. Null means indefinite. Checked at
  /// read time rather than expired by a job — a job that fails would leave
  /// someone holding rights they were meant to lose.
  adminUntil     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  body           String       @db.Text
  createdAt      DateTime     @default(now())

  /// Quoted message this one replies to.
  replyToId String?
  replyTo   Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReply")

  /// Name of the original sender when this message was forwarded.
  forwardedFromName String?

  /// A notice the app wrote, not a person — someone joined, the group was
  /// renamed. Rendered as a centred capsule rather than a bubble, and never
  /// pinned, replied to or reacted to.
  isSystem Boolean @default(false)

  /// "Delete for everyone" — kept as a tombstone so the thread shows a placeholder.
  deletedForEveryone Boolean @default(false)

  pinnedAt   DateTime?
  pinnedById String?

  attachments MessageAttachment[]
  reactions   MessageReaction[]
  hiddenFor   MessageHidden[]

  @@index([conversationId, createdAt])
  @@index([replyToId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("MessageReactionUser", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

/// "Delete for me" — hides a message for one user without removing it for others.
model MessageHidden {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String
  size      Int
  /// base64 data URL stored in MySQL (images + documents only; no video).
  data      String   @db.LongText
  createdAt DateTime @default(now())

  @@index([messageId])
}

/// Every write in the CRM, recorded automatically.
///
/// Written by a Prisma extension rather than by each route, so a new endpoint
/// is covered the day it's added instead of the day someone remembers to log
/// from it.
model AuditLog {
  id        String   @id @default(cuid())
  /// Prisma model name — "Lead", "Task", "User"…
  model     String
  /// create | update | delete
  action    String
  /// Primary key of the affected row, when the operation exposes one.
  recordId  String?
  /// Human-readable summary, e.g. "Lead \"Acme Corp\" updated".
  summary   String   @db.Text
  /// The changed fields, as JSON. Null for deletes.
  changes   Json?
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([model, recordId])
  @@index([actorId, createdAt])
  @@index([model, createdAt])
}

// ---------- Social Media Management ----------
//
// Restricted to a specific team, not every department user — see the
// "social-media" Team/TeamMember rows and src/lib/social-media.ts. Company
// Admin/Super Admin always have full access without needing a membership
// row, same as every other module's isAdmin() override.

enum SocialClientStage {
  ENQUIRY
  CALLING
  MEETING
  PLAN_DISCUSSION
  APPROVAL
  ONBOARDED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  TWITTER
  YOUTUBE
}

enum SocialContentType {
  STATIC_POST
  CAROUSEL
  AI_REEL
  REAL_PERSON_REEL
}

/// The four fixed columns of the suggested monthly content calendar grid.
enum SocialCalendarWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// Upload/production status shown as colored text on a filled calendar
/// slot — green (DONE), orange (PENDING), red (NOT_UPLOADED, the default).
enum SocialCalendarSlotStatus {
  NOT_UPLOADED
  PENDING
  DONE
}

/// One shared enum across all four content types; each type's own ordered
/// subsequence lives in code (src/lib/social-content-workflow.ts), not here —
/// static post/carousel, AI reel, and real-person reel each walk a different
/// subset (e.g. only REAL_PERSON_REEL passes through CLIENT_CLIPS_RECEIVED and
/// EDITING; only the two reel types start at SCRIPT). DRAFT is legacy — kept
/// so old rows created before the per-type workflows still resolve to a
/// value, no longer used as a starting stage for new content.
enum SocialContentStage {
  DRAFT
  SCRIPT
  SCRIPT_APPROVED
  SHARED_IN_GROUP
  APPROVED_TO_PROCEED
  CLIENT_CLIPS_RECEIVED
  EDITING
  IN_PRODUCTION
  SHARED_FOR_REVIEW
  APPROVED_FINAL
  PUBLISHED
  CANCELLED
}

enum SocialAdObjective {
  LEADS
  REACH
  FOLLOWERS
}

enum SocialAdStage {
  DISCUSSION
  BUDGET_DURATION
  TARGETING
  CONTENT_APPROVAL
  AD_CREATION
  GROUP_APPROVAL
  CAMPAIGN_SETUP
  RUNNING
  REPORTING
  COMPLETED
  CANCELLED
}

// ---------- CRM Team ----------

/// The CRM Team's own membership roster — kept as a separate model rather
/// than a shared "TeamMember" so this module's scoping/permission logic
/// stays independently simple, matching how the rest of this schema already
/// keeps Social Media's own models apart from everyone else's.
model CrmMember {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------- Teams (generic) ----------

/// A generic team — Social Media and CRM are seeded as `isSystem` teams
/// (see scripts/migrate-social-crm-to-teams.ts) that `src/lib/social-media.ts`
/// and `src/lib/crm-team.ts` read/write through by slug, alongside any
/// custom team (e.g. "IT") created from the Teams page. `disabled` is
/// enforced where membership is looked up, so disabling a team cuts off
/// access everywhere that scopes by it without touching each call site.
model Team {
  id        String       @id @default(cuid())
  name      String
  /// Fixed at creation — business logic (Forms access, the Social Media
  /// Quotations exclusion) keys off "social-media"/"crm" specifically, so
  /// this is never user-editable, unlike `name`.
  slug      String       @unique
  isSystem  Boolean      @default(false)
  disabled  Boolean      @default(false)
  createdAt DateTime     @default(now())
  members   TeamMember[]
  invites   Invite[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

enum CallType {
  INCOMING
  OUTGOING
  MISSED
}

/// A call log entry for the CRM Team — who was called (a Lead, and/or a
/// free-text client name), when, by whom, and what's next. There's no
/// standalone "Client" entity outside Social Media's own SocialClient (see
/// the /clients page), so `clientName` is plain text rather than a relation —
/// building a whole new Client model wasn't part of this request.
model Call {
  id          String    @id @default(cuid())
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientName  String?
  callType    CallType
  startTime   DateTime
  endTime     DateTime?
  ownerId     String
  owner       User      @relation("CallOwner", fields: [ownerId], references: [id])
  /// What happens next — a follow-up call, an email, closing the deal, etc.
  nextAction  String?   @db.Text
  subject     String?
  description String?   @db.Text
  createdById String
  createdBy   User      @relation("CallCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([leadId])
  @@index([ownerId])
  @@index([startTime])
}

model SocialClient {
  id            String            @id @default(cuid())
  name          String
  companyName   String?
  contactPerson String?
  phone         String?
  email         String?
  stage         SocialClientStage @default(ENQUIRY)
  planNotes     String?           @db.Text
  approvedAt    DateTime?
  onboardedAt   DateTime?
  assignedToId  String?
  assignedTo    User?             @relation("SocialClientAssignedTo", fields: [assignedToId], references: [id])
  createdById   String
  createdBy     User              @relation("SocialClientCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  /// Manual drag-to-reorder position in the Clients folder grid. Shared
  /// across the team, not per-viewer; ties (the default 0) fall back to
  /// createdAt so unordered clients still sort consistently.
  folderOrder   Int               @default(0)

  platformAccounts SocialPlatformAccount[]
  contentItems     SocialContentItem[]
  adCampaigns      SocialAdCampaign[]
  monthlyReports   SocialMonthlyReport[]
  activities       SocialClientActivity[]
  calendarSlots    SocialContentCalendarSlot[]
  folders          SocialClientFolder[]

  @@index([stage])
  @@index([assignedToId])
}

/// A flat (single-level) folder for organizing a client's images — the
/// Files tab's own grouping, distinct from platform credentials/content/ads.
model SocialClientFolder {
  id          String       @id @default(cuid())
  clientId    String
  client      SocialClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  createdById String
  createdBy   User         @relation("SocialClientFolderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  images SocialClientImage[]

  @@index([clientId])
}

/// One uploaded image inside a SocialClientFolder — same base64-in-MySQL
/// upload shape as TaskAttachment/ProjectDocument/SocialReportFile.
model SocialClientImage {
  id           String             @id @default(cuid())
  folderId     String
  folder       SocialClientFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  data         String             @db.LongText
  uploadedById String
  uploadedBy   User               @relation("SocialClientImageUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([folderId])
}

/// Tracks which platforms are connected and whether login credentials have
/// been collected. `password` is stored as plain text, per explicit request —
/// no hashing or encryption here (unlike User.passwordHash/pinHash, which
/// stay one-way hashes since those are never meant to come back out).
model SocialPlatformAccount {
  id                     String         @id @default(cuid())
  clientId               String
  client                 SocialClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform               SocialPlatform
  handle                 String?
  credentialsReceived    Boolean        @default(false)
  password               String?        @db.Text
  credentialsUpdatedAt   DateTime?
  credentialsUpdatedById String?
  credentialsUpdatedBy   User?          @relation("SocialPlatformCredentialsUpdatedBy", fields: [credentialsUpdatedById], references: [id])
  notes                  String?        @db.Text
  createdById            String?
  createdBy              User?          @relation("SocialPlatformCreatedBy", fields: [createdById], references: [id])
  updatedById            String?
  updatedBy              User?          @relation("SocialPlatformUpdatedBy", fields: [updatedById], references: [id])
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@unique([clientId, platform])
}

/// One cell in the suggested monthly content calendar grid (4 weeks x
/// Monday/Wednesday/Friday/Saturday, per doc section 7). Deliberately a
/// lightweight planning entry, not a real SocialContentItem — this is a plan
/// slot ("Static #1", "Reel #2", or a freeform note like "Planning Meeting"),
/// independent of the Content tab's own DRAFT->PUBLISHED workflow. Display
/// numbering ("#N") is computed at render time from ordering (week, then
/// weekday) among same-contentType slots, not stored.
model SocialContentCalendarSlot {
  id           String                   @id @default(cuid())
  clientId     String
  client       SocialClient             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  year         Int
  month        Int
  week         Int
  weekday      SocialCalendarWeekday
  contentType  SocialContentType?
  /// Freeform label, only meaningful when contentType is null (e.g. "Planning Meeting").
  note         String?
  /// Overrides the auto-computed "#N" position within this month's same
  /// contentType (ordered by week/weekday) — null keeps the automatic order.
  manualNumber Int?
  status       SocialCalendarSlotStatus @default(NOT_UPLOADED)
  createdById  String
  createdBy    User                     @relation("SocialCalendarSlotCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([clientId, year, month, week, weekday])
  @@index([clientId, year, month])
}

/// One row per piece of content across all four workflows (static post,
/// carousel, AI reel, real-person reel). No assignedToId — visibility
/// follows the parent client's ownership, since a client's content is
/// worked on by whoever's covering that client, not assigned post-by-post.
model SocialContentItem {
  id           String             @id @default(cuid())
  clientId     String
  client       SocialClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type         SocialContentType
  title        String
  caption      String?            @db.Text
  hashtags     String?
  stage        SocialContentStage @default(DRAFT)
  /// Comma-separated SocialPlatform values — "publish on all platforms"
  /// means a single post can target more than one at once.
  platforms    String
  scheduledFor DateTime?
  publishedAt  DateTime?
  createdById  String
  createdBy    User               @relation("SocialContentCreatedBy", fields: [createdById], references: [id])
  updatedById  String?
  updatedBy    User?              @relation("SocialContentUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  approvals SocialContentApproval[]

  @@index([clientId])
  @@index([stage])
  @@index([type])
}

/// Append-only stage-transition log, same shape as QuotationApproval.
model SocialContentApproval {
  id        String             @id @default(cuid())
  contentId String
  content   SocialContentItem  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User               @relation(fields: [actorId], references: [id])
  fromStage SocialContentStage
  toStage   SocialContentStage
  comment   String?            @db.Text
  decidedAt DateTime           @default(now())
}

model SocialAdCampaign {
  id               String            @id @default(cuid())
  clientId         String
  client           SocialClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name             String
  objective        SocialAdObjective
  /// Comma-separated SocialPlatform values, same shape as
  /// SocialContentItem.platforms — null on ads created before this field.
  platforms        String?
  budget           Decimal?          @db.Decimal(12, 2)
  durationDays     Int?
  targetAudience   String?           @db.Text
  location         String?
  stage            SocialAdStage     @default(DISCUSSION)
  startedAt        DateTime?
  endedAt          DateTime?
  leadsGenerated   Int?
  reach            Int?
  cost             Decimal?          @db.Decimal(12, 2)
  ctr              Decimal?          @db.Decimal(5, 2)
  conversions      Int?
  retargetingNotes String?           @db.Text
  createdById      String
  createdBy        User              @relation("SocialAdCreatedBy", fields: [createdById], references: [id])
  updatedById      String?
  updatedBy        User?             @relation("SocialAdUpdatedBy", fields: [updatedById], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([clientId])
  @@index([stage])
}

model SocialMonthlyReport {
  id                     String       @id @default(cuid())
  clientId               String
  client                 SocialClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  year                   Int
  month                  Int
  title                  String?
  description            String?      @db.Text
  reach                  Int?
  engagement             Int?
  followersGained        Int?
  bestPosts              String?      @db.Text
  adSpend                Decimal?     @db.Decimal(12, 2)
  adLeads                Int?
  adCost                 Decimal?     @db.Decimal(12, 2)
  adCtr                  Decimal?     @db.Decimal(5, 2)
  adConversions          Int?
  insights               String?      @db.Text
  retargetingSuggestions String?      @db.Text
  nextMonthPlan          String?      @db.Text
  reviewedAt             DateTime?
  createdById            String
  createdBy              User         @relation("SocialReportCreatedBy", fields: [createdById], references: [id])
  updatedById            String?
  updatedBy              User?        @relation("SocialReportUpdatedBy", fields: [updatedById], references: [id])
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  files SocialReportFile[]

  @@unique([clientId, year, month])
}

/// One uploaded attachment on a monthly report — same base64-in-MySQL shape
/// as TaskAttachment/ProjectDocument. Multiple files per report; each can be
/// removed or replaced independently from the report form.
model SocialReportFile {
  id           String              @id @default(cuid())
  reportId     String
  report       SocialMonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  data         String              @db.LongText
  uploadedById String
  uploadedBy   User                @relation("SocialReportFileUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime            @default(now())

  @@index([reportId])
}

model SocialClientActivity {
  id        String       @id @default(cuid())
  clientId  String
  client    SocialClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User         @relation(fields: [actorId], references: [id])
  action    String
  meta      Json?
  createdAt DateTime     @default(now())

  @@index([clientId])
}

// ---------- Password Manager ----------

/// A stored credential. Visible by default only to users in the same
/// department (departmentId), plus anyone it's been explicitly shared with
/// via PasswordEntryShare — admins/super admins see every entry regardless
/// of department. `password` is stored as plain text, per explicit request
/// — same as SmtpSettings.password and SocialPlatformAccount.password
/// elsewhere in this schema — but is still never selected into a list
/// response or the generic audit trail (see AUDIT_IGNORED_MODELS in
/// src/lib/audit.ts); only the reveal endpoint ever returns it, and every
/// call there is logged.
model PasswordEntry {
  id             String  @id @default(cuid())
  label          String
  description    String? @db.Text
  link           String?
  username       String?
  password       String  @db.Text
  /// Fetched once from a trusted favicon service (never the stored link
  /// itself, so this never makes an outbound request to a user-supplied
  /// host) — lets an entry be recognized at a glance in the list.
  faviconDataUrl String? @db.LongText

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  createdById String
  createdBy   User    @relation("PasswordEntryCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("PasswordEntryUpdatedBy", fields: [updatedById], references: [id])

  /// Set once the rotation reminder sweep has nagged the creator/last editor
  /// that this entry's password is stale — cleared whenever the password
  /// value itself is changed, so staying stale again later gets a fresh nag.
  rotationReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shares     PasswordEntryShare[]
  activities PasswordEntryActivity[]

  @@index([departmentId])
}

/// Grants one specific user access to one specific entry, independent of
/// their department — the "share with another user" escape hatch on top of
/// the department-default visibility above.
model PasswordEntryShare {
  id              String        @id @default(cuid())
  passwordEntryId String
  passwordEntry   PasswordEntry @relation(fields: [passwordEntryId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation("PasswordEntrySharedWith", fields: [userId], references: [id])
  sharedById      String
  sharedBy        User          @relation("PasswordEntrySharedBy", fields: [sharedById], references: [id])
  createdAt       DateTime      @default(now())

  @@unique([passwordEntryId, userId])
  @@index([userId])
}

/// Purpose-built activity log for one entry — created/updated/shared/
/// unshared/revealed — kept separate from the generic AuditLog so a
/// credential's access history (who revealed it, and when) is always
/// available without ever risking the secret value itself landing in a
/// general-purpose log. Never records the password.
model PasswordEntryActivity {
  id              String        @id @default(cuid())
  passwordEntryId String
  passwordEntry   PasswordEntry @relation(fields: [passwordEntryId], references: [id], onDelete: Cascade)
  actorId         String
  actor           User          @relation(fields: [actorId], references: [id])
  action          String
  meta            Json?
  createdAt       DateTime      @default(now())

  @@index([passwordEntryId])
  @@index([actorId])
}

// ---------- Leave requests ----------

enum LeaveCategory {
  CASUAL
  SICK
  EARNED
  UNPAID
  OTHER
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A team member's application for leave, awaiting an admin's decision. Approving
/// one is what writes the per-day UserLeave rows (and stamps attendance) that the
/// attendance module already understands; the request itself is the record of
/// who asked, why, and who decided when.
model LeaveRequest {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation("LeaveRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  category    LeaveCategory      @default(CASUAL)
  startDate   DateTime           @db.Date
  endDate     DateTime           @db.Date
  isHalfDay   Boolean            @default(false)
  /// Working days covered (Sundays/holidays excluded; 0.5 for a half day).
  /// Computed server-side at apply time, never trusted from the client.
  days        Float
  reason      String             @db.Text
  status      LeaveRequestStatus @default(PENDING)
  decidedById String?
  decidedBy   User?              @relation("LeaveRequestDecider", fields: [decidedById], references: [id])
  /// The "Action Date": when an admin approved/rejected, or the user cancelled.
  decidedAt   DateTime?
  adminNote   String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, startDate])
  @@index([status])
}

enum ExpenseCategory {
  TRAVEL
  FOOD
  ACCOMMODATION
  OFFICE_SUPPLIES
  SOFTWARE
  CLIENT_ENTERTAINMENT
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

/// An employee's reimbursement claim, awaiting an admin/department-admin
/// decision — same submit-then-decide shape as LeaveRequest just above,
/// but with a money amount and an optional receipt instead of a date range.
/// PAID is a separate step from APPROVED (approving says "this is a
/// legitimate claim"; marking paid says "the money has actually moved"),
/// so the two are tracked independently rather than collapsed into one.
model Expense {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation("ExpenseUser", fields: [userId], references: [id], onDelete: Cascade)
  category    ExpenseCategory @default(OTHER)
  /// Required only when category is OTHER — what the "other" expense
  /// actually was, so an admin reviewing claims doesn't have to rely on the
  /// free-form description alone to tell what kind of spend this was.
  categoryOther String?       @db.VarChar(200)
  amount      Decimal         @db.Decimal(10, 2)
  expenseDate DateTime        @db.Date
  description String          @db.Text
  status      ExpenseStatus   @default(PENDING)
  decidedById String?
  decidedBy   User?           @relation("ExpenseDecider", fields: [decidedById], references: [id])
  /// The "Action Date": when an admin approved/rejected, or the user cancelled.
  decidedAt   DateTime?
  adminNote   String?         @db.Text
  /// Set only once the reimbursement has actually been paid out — independent
  /// of decidedAt, since approval and payment often happen on different days.
  paidAt      DateTime?
  receiptFileName String?
  receiptFilePath String?
  /// Base64, same MySQL-column storage as TaskAttachment/ProjectDocument —
  /// no filesystem/S3 involved. Null when no receipt was attached.
  receiptData     String?     @db.LongText

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, expenseDate])
  @@index([status])
}

// ---------- Client accounts (admin) ----------

enum ClientCategory {
  CRM
  WEBSITE
  WHATSAPP
  SMM
  DDQ
}

/// A company we sell a product to. Distinct from SocialClient, which is the
/// Social Media team's day-to-day working record.
model Client {
  id            String             @id @default(cuid())
  name          String
  category      ClientCategory
  /// Why the client came to us / what they bought the product for.
  reason        String?            @db.Text
  ownerName     String
  mobile        String?
  email         String?
  ownerBirthday DateTime?          @db.Date
  /// The product's contract window.
  productStart  DateTime?          @db.Date
  productEnd    DateTime?          @db.Date
  createdById   String
  createdBy     User               @relation("ClientCreatedBy", fields: [createdById], references: [id])
  team          ClientTeamMember[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([category])
}

model ClientTeamMember {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation("ClientTeamMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Free text, e.g. "Developer", "Account manager".
  role     String

  @@unique([clientId, userId])
}

// ---------- Birthday gifts ----------

/// The gift an admin has chosen for someone's birthday in a given year (the year
/// the birthday falls in, so a new year starts with no gift chosen). Free text:
/// Hamper / Cake / Plant are just the suggested options. Rows are kept after the
/// birthday, which is what makes the gift history.
model BirthdayGift {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("BirthdayGiftFor", fields: [userId], references: [id], onDelete: Cascade)
  year        Int
  gift        String   @db.VarChar(100)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, year])
}

/// Tracks that the "no gift picked yet" reminder already went out for this
/// person's upcoming birthday in a given year, so the daily sweep (which
/// checks every day in the week before a birthday) doesn't nag gift-pickers
/// more than once per year. Rows aren't cleaned up — same as BirthdayGift,
/// they're cheap and harmless to keep around.
model BirthdayGiftReminder {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year   Int
  sentAt DateTime @default(now())

  @@unique([userId, year])
}

/// Tracks that the "Happy Birthday" broadcast already went out to the whole
/// company for this person's birthday this year, so the daily sweep (which
/// checks every day) only ever sends it once per year even though it keeps
/// checking daily up to and past the date.
model BirthdayWishSent {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year   Int
  sentAt DateTime @default(now())

  @@unique([userId, year])
}

// ---------- Website onboarding form ----------

enum OnboardingAttachmentKind {
  LOGO
  FOUNDER_DIRECTOR
  TEAM
  AWARDS_TESTIMONIALS
}

/// A client's answers to the public Website Onboarding Form (src/app/onboarding-form).
/// Anyone with the link can submit one — there's no account behind it, so there's no
/// relation back to User. Visible only to Admins and the Development department (see
/// canViewOnboardingSubmissions in src/lib/onboarding.ts).
model OnboardingSubmission {
  id String @id @default(cuid())

  fullName     String
  phone        String
  email        String
  companyName  String
  aboutCompany String @db.Text

  arnNo           String
  arnRegistration String @db.Text
  euinNo          String
  cinNo           String?
  panNo           String?
  gstinNo         String?

  grievanceFirstName String?
  grievanceLastName  String?
  grievanceEmail     String?
  grievanceContact   String?

  existingWebsite String?
  loginLink       String?
  signupLink      String?

  ourMission String? @db.Text
  ourVision  String? @db.Text
  ourPurpose String? @db.Text

  supportPhone String
  supportEmail String

  addressStreet     String?
  addressLine2      String?
  addressCity       String?
  addressState      String?
  addressPostalCode String?
  addressCountry    String? @default("India")

  hostingProvider    String?
  hostingCredentials String? @db.Text

  attachments OnboardingAttachment[]

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model OnboardingAttachment {
  id           String               @id @default(cuid())
  submissionId String
  submission   OnboardingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  kind         OnboardingAttachmentKind
  fileName     String
  data         String               @db.LongText

  createdAt DateTime @default(now())

  @@index([submissionId])
}

// ---------- Forms (generic form builder) ----------

enum FormFieldType {
  SHORT_TEXT
  LONG_TEXT
  EMAIL
  PHONE
  LINK
  PASSWORD
  NUMBER
  DATE
  DROPDOWN
  RADIO
  CHECKBOX
  FILE_SINGLE
  FILE_MULTI
  SECTION_HEADING
  /// Layout-only, like SECTION_HEADING — splits the form into steps at the
  /// public page. Never has an answer.
  PAGE_BREAK
}

/// A form an admin built with the drag-and-drop builder (src/app/(dashboard)/forms).
/// Lives at the public, unauthenticated /f/[slug] — anyone with the link can submit
/// it, same as the Website Onboarding Form. `slug` is the public URL segment.
model Form {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  slug        String   @unique
  isActive    Boolean  @default(true)
  /// When false (the default), copying the link rotates it to a fresh
  /// random slug first — the old link stops working. Set true for a form
  /// whose link needs to stay stable, e.g. one embedded on a website.
  lockSlug    Boolean  @default(false)
  createdById String
  createdBy   User     @relation("FormCreatedBy", fields: [createdById], references: [id])
  /// Which department this form was built for — distinct from
  /// viewerDepartments (who may see submissions). Nullable: forms created
  /// before this field existed have none until an admin sets one.
  departmentId String?
  department   Department? @relation("FormDepartment", fields: [departmentId], references: [id])

  /// Incremented once per page load at the public /f/[slug] URL — the
  /// denominator for the analytics conversion rate (submissions / views).
  /// A simple counter, not a per-visitor log: good enough to answer "is
  /// this form converting," not meant to dedupe repeat visits.
  viewCount Int @default(0)

  fields          FormField[]
  submissions     FormSubmission[]
  viewerDepartments FormViewerDepartment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Which departments besides Admins may view a given form's submissions —
/// mirrors the Website Onboarding Form's "Admins + Development" rule, but
/// configurable per form instead of hard-coded to one department.
model FormViewerDepartment {
  id           String     @id @default(cuid())
  formId       String
  form         Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([formId, departmentId])
}

model FormField {
  id          String        @id @default(cuid())
  formId      String
  form        Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  type        FormFieldType
  label       String
  placeholder String?
  helpText    String?       @db.Text
  required    Boolean       @default(false)
  /// Display order within the form — the builder's drag-and-drop reorders this.
  order       Int
  /// Pipe-separated choices for DROPDOWN/RADIO/CHECKBOX, e.g. "Red|Green|Blue".
  options     String?       @db.Text
  /// Character-length bounds, for text-like field types.
  minLength   Int?
  maxLength   Int?
  /// Value bounds, for NUMBER fields.
  minValue    Int?
  maxValue    Int?
  /// Regex source (no flags) a text-like answer must match, e.g. an EMAIL/PHONE shape.
  pattern     String?       @db.VarChar(500)

  /// Conditional logic — this field (and its validation/requiredness) is
  /// only in play when the field `conditionFieldId` points at currently
  /// satisfies `conditionOperator`/`conditionValue`. A soft pointer, not a
  /// relation, like the other cross-row ids in this file: a field that gets
  /// deleted should just stop gating anything, not take its dependents down
  /// with it. The builder only ever offers an earlier field (lower `order`)
  /// as the target, so evaluation in display order never has to look ahead.
  conditionFieldId String?
  /// "equals" | "not_equals" | "contains" | "is_filled" | "is_empty"
  conditionOperator String?
  conditionValue    String?       @db.Text

  answers     FormAnswer[]
  attachments FormAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

