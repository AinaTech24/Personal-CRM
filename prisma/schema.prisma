  storageKey       String   @map("storage_key") @db.VarChar(800)
  originalFilename String   @map("original_filename") @db.VarChar(255)
  sha256           String   @db.Char(64)
  mimeType         String   @map("mime_type") @db.VarChar(100)
  sizeBytes        BigInt   @map("size_bytes")
  scanStatus       String   @map("scan_status") @db.VarChar(30)
  encryptionKeyRef String?  @map("encryption_key_ref") @db.VarChar(255)
  uploadedByUserId String   @map("uploaded_by_user_id")

  @@index([workspaceId, sha256])
  @@index([mfdOrgId])
  @@index([uploadedByUserId])
  @@map("cc_file_objects")
}

/// Immutable binary version references.
model CcDocumentVersion {
  id               String   @id @default(uuid())
  workspaceId      String   @map("workspace_id")
  createdAt        DateTime @default(now()) @map("created_at")
  documentId       String   @map("document_id")
  versionNo        Int      @map("version_no")
  fileObjectId     String   @map("file_object_id")
  uploadedAt       DateTime @map("uploaded_at")
  uploadedByUserId String   @map("uploaded_by_user_id")
  changeNote       String?  @map("change_note") @db.Text

  @@unique([documentId, versionNo])
  @@index([workspaceId])
  @@index([fileObjectId])
  @@index([uploadedByUserId])
  @@map("cc_document_versions")
}

/// Typed targets checked in service; guard same tenant / org.
model CcDocumentLink {
  id             String   @id @default(uuid())
  workspaceId    String   @map("workspace_id")
  createdAt      DateTime @default(now()) @map("created_at")
  documentId     String   @map("document_id")
  entityType     String   @map("entity_type") @db.VarChar(50)
  entityId       String   @map("entity_id")
  linkedAt       DateTime @map("linked_at")
  linkedByUserId String   @map("linked_by_user_id")

  @@index([workspaceId])
  @@index([documentId])
  @@index([linkedByUserId])
  @@map("cc_document_links")
}

/// Recipient/copy and sender parties.
model CcCommunicationParticipant {
  id              String   @id @default(uuid())
  workspaceId     String   @map("workspace_id")
  createdAt       DateTime @default(now()) @map("created_at")
  communicationId String   @map("communication_id")
  contactId       String?  @map("contact_id")
  memberId        String?  @map("member_id")
  participantRole String   @map("participant_role") @db.VarChar(40)

  @@index([workspaceId])
  @@index([communicationId])
  @@index([contactId])
  @@index([memberId])
  @@map("cc_communication_participants")
}

/// Versioned KPI semantics and comparable time-series.
model CcKpiDefinition {
  id              String   @id @default(uuid())
  workspaceId     String   @map("workspace_id")
  createdAt       DateTime @default(now()) @map("created_at")
  metricCode      String   @map("metric_code") @db.VarChar(80)
  version         Int
  name            String   @db.VarChar(220)
  unit            String   @db.VarChar(20)
  formula         String?  @db.Text
  aggregationRule String   @map("aggregation_rule") @db.VarChar(120)
  signRule        String   @map("sign_rule") @db.VarChar(120)
  evidencePolicy  String?  @map("evidence_policy") @db.Text
  activeFrom      DateTime @map("active_from") @db.Date

  @@unique([workspaceId, metricCode, version])
  @@map("cc_kpi_definitions")
}

/// Support partial / multiple payments; never fake allocation.
model CcPaymentAllocation {
  id               String   @id @default(uuid())
  workspaceId      String   @map("workspace_id")
  createdAt        DateTime @default(now()) @map("created_at")
  billingRecordId  String   @map("billing_record_id")
  paymentReference String   @map("payment_reference") @db.VarChar(150)
  amount           Decimal  @db.Decimal(18, 2)
  receivedAt       DateTime @map("received_at")
  sourceSystem     String?  @map("source_system") @db.VarChar(80)

  @@index([workspaceId])
  @@index([billingRecordId])
  @@map("cc_payment_allocations")
}

/// Append-only approvals and state transitions.
model CcApprovalAuditEvent {
  id                 String   @id @default(uuid())
  workspaceId        String   @map("workspace_id")
  createdAt          DateTime @default(now()) @map("created_at")
  entityType         String   @map("entity_type") @db.VarChar(60)
  entityId           String   @map("entity_id")
  actorUserId        String   @map("actor_user_id")
  oldState           String?  @map("old_state") @db.VarChar(50)
  newState           String   @map("new_state") @db.VarChar(50)
  eventAt            DateTime @map("event_at")
  evidenceDocumentId String?  @map("evidence_document_id")

  @@index([entityType, entityId])
  @@index([workspaceId])
  @@index([actorUserId])
  @@index([evidenceDocumentId])
  @@map("cc_approval_audit_events")
}

/// Append-only immutable system change trail.
model CcAuditEvent {
  id             String   @id @default(uuid())
  workspaceId    String   @map("workspace_id")
  createdAt      DateTime @default(now()) @map("created_at")
  userId         String?  @map("user_id")
  entityTable    String   @map("entity_table") @db.VarChar(100)
  entityId       String   @map("entity_id")
  action         String   @db.VarChar(60)
  changedColumns Json?    @map("changed_columns")
  recordedAt     DateTime @map("recorded_at")
  ipClass        String?  @map("ip_class") @db.VarChar(80)

  @@index([workspaceId, recordedAt])
  @@index([entityTable, entityId])
  @@index([userId])
  @@map("cc_audit_events")
}

/// Transactional outbox for reliable async jobs.
model CcOutboxEvent {
  id             String    @id @default(uuid())
  workspaceId    String    @map("workspace_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  eventType      String    @map("event_type") @db.VarChar(100)
  aggregateId    String    @map("aggregate_id")
  payloadJson    Json      @map("payload_json")
  state          String    @db.VarChar(30)
  publishedAt    DateTime? @map("published_at")
  retryCount     Int       @default(0) @map("retry_count")
  idempotencyKey String    @map("idempotency_key") @db.VarChar(128)

  @@unique([workspaceId, idempotencyKey])
  @@index([state, createdAt])
  @@map("cc_outbox_events")
}

/// Delivery and retry tracking.
model CcNotificationDelivery {
  id                String    @id @default(uuid())
  workspaceId       String    @map("workspace_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  recipientUserId   String    @map("recipient_user_id")
  templateCode      String    @map("template_code") @db.VarChar(100)
  channel           String    @db.VarChar(40)
  state             String    @db.VarChar(30)
  attemptedAt       DateTime? @map("attempted_at")
  providerMessageId String?   @map("provider_message_id") @db.VarChar(180)

  @@index([workspaceId])
  @@index([recipientUserId])
  @@map("cc_notification_deliveries")
}

/// Prevent purge when preservation is authorized/required.
model CcRetentionHold {
  id             String    @id @default(uuid())
  workspaceId    String    @map("workspace_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  mfdOrgId       String?   @map("mfd_org_id")
  entityType     String    @map("entity_type") @db.VarChar(80)
  entityId       String    @map("entity_id")
  reason         String    @db.Text
  status         String    @db.VarChar(30)
  placedAt       DateTime  @map("placed_at")
  placedByUserId String    @map("placed_by_user_id")
  releasedAt     DateTime? @map("released_at")

  @@index([workspaceId])
  @@index([mfdOrgId])
  @@index([placedByUserId])
  @@map("cc_retention_holds")
}

/// Server-issued reference numbers (LEAD-2026-000001 …), incremented atomically per workspace and key.
model CcSequence {
  workspaceId String   @map("workspace_id")
  key         String   @db.VarChar(60)
  value       Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([workspaceId, key])
  @@map("cc_sequences")
}

/// Private object store behind file_objects.storage_key — swap for S3 by
/// replacing src/lib/mfd/storage.ts; nothing else reads this table.
model CcFileBlob {
  storageKey String   @id @map("storage_key") @db.VarChar(191)
  data       Bytes    @db.LongBlob
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("cc_file_blobs")
}

