generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------- Core / Auth ----------

enum Role {
  SUPER_ADMIN
  ADMIN
  DEPARTMENT_USER
}

model Department {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users           User[]
  leads           Lead[]
  projects        Project[]
  quotations      Quotation[]
  invoices        Invoice[]
  invites         Invite[]
  passwordEntries PasswordEntry[]
  formViewers     FormViewerDepartment[]
  forms           Form[]                 @relation("FormDepartment")
  notes           Note[]
}

/// A module an admin can individually grant a user full ("admin-equivalent")
/// manage access to, on top of whatever their role/department would normally
/// allow — see src/lib/module-permissions.ts.
enum ManagedModule {
  LEAVE
  ATTENDANCE
  TASKS
  MEETINGS
  LEADS
  CLIENTS
  BIRTHDAYS
  MESSAGES
  PROJECTS
  EXPENSES
  NOTES
  /// Build/edit/delete forms and manage submissions — same flat, company-wide
  /// capability a Social Media or CRM team lead already has (see
  /// canManageForms in src/lib/forms.ts), just reachable via a Permission
  /// Manager grant too, for someone who isn't a team lead.
  FORMS
  /// See every call, not just your own or your CRM team's — Call has no
  /// department of its own to scope to, so this is flat ("all" or nothing),
  /// same as FORMS/BIRTHDAYS, not department-scoped like LEADS/TASKS.
  CALLS
}

/// A personal note. Visibility is its own fixed 3-tier floor (Admin/Super
/// Admin → everyone; a Department Admin → their own department; everyone
/// else → only their own notes), which a Permission Manager NOTES grant can
/// still widen the same way a Tasks/Leads/Meetings grant does — see
/// src/lib/notes.ts. `departmentId` snapshots the author's department at
/// creation time, same
/// as Lead/Task/etc., so department-scoped visibility survives the author
/// later moving departments or being deactivated.
model Note {
  id           String      @id @default(cuid())
  title        String
  content      String      @db.Text
  /// A hex color ("#fecdd3") picked freely in the UI, or null to use the
  /// normal theme card background — not a fixed named palette.
  color        String?     @db.VarChar(7)
  isPinned     Boolean     @default(false)
  /// Pipe-delimited with a leading and trailing pipe ("|work|urgent|"), never
  /// null unless there are no tags — the delimiters let a `contains` query
  /// match one whole tag without accidentally matching inside a longer one
  /// (e.g. "work" inside "homework"). See src/lib/note-tags.ts.
  tags         String?     @db.VarChar(500)
  authorId     String
  author       User        @relation("NoteAuthor", fields: [authorId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  /// Soft delete for the Trash module — see Lead.deletedAt for the full reasoning.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?       @relation("NoteDeletedBy", fields: [deletedById], references: [id])

  @@index([authorId])
  @@index([departmentId])
  @@index([deletedAt])
}

/// One row per (user, module), company-wide — the same shape as CrmMember
/// (one row per grant) but generic across every module rather than tied to
/// one team. The four booleans are independent:
/// a user can be granted, say, read+update on Tasks without create or
/// delete. A row with every flag false is equivalent to no row at all —
/// see hasAnyModulePermission in module-permissions-store.ts. An
/// Admin/Super Admin already has every action on every module regardless
/// of what's granted here.
model UserModulePermission {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  module         ManagedModule
  canCreate      Boolean       @default(false)
  canRead        Boolean       @default(false)
  canUpdate      Boolean       @default(false)
  canDelete      Boolean       @default(false)
  /// An explicit per-person override that hides this module's nav link for
  /// them entirely, regardless of their usual baseline own-record access —
  /// distinct from simply holding no CRUD grant (which only withholds the
  /// department-wide widening those four flags give; baseline access to
  /// one's own records stays either way). Defaults false so every existing
  /// row, and anyone never touched here at all, is unaffected.
  blocked        Boolean       @default(false)
  /// Widens this grant's scope from "the grant holder's own department" to
  /// company-wide — the same breadth a real Admin gets for this module.
  /// Only a company Admin may set this (see the PUT handler for this
  /// matrix): a Department Admin/team lead granting someone's CRUD access
  /// is already bounded to their own department, so letting them also flip
  /// this would let them hand a report more reach than they themselves
  /// have. Meaningless without at least one of the CRUD flags above also
  /// being true — moduleAccessScope only consults it once an action is
  /// otherwise granted.
  allDepartments Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@unique([userId, module])
  @@index([userId])
}

model User {
  id                    String      @id @default(cuid())
  email                 String      @unique
  passwordHash          String
  name                  String
  surname               String?
  // @unique with a nullable String is fine in MySQL — any number of NULL rows
  // are allowed, only two rows sharing the same non-null value would collide.
  mobile                String?     @unique
  // Date of birth, set by an admin. Only month/day are shown to colleagues
  // (see /api/birthdays); the year stays admin-only.
  birthday              DateTime?   @db.Date
  // Job title, e.g. "Software Engineer". Self-service once (same rule as
  // birthday: free to set while empty, admin-only to change afterward) — see
  // the onboarding-completion prompt that nudges anyone missing it.
  designation           String?
  // When they actually joined, which can predate their account's own
  // createdAt (e.g. historical data entered later). Same self-service-once
  // rule as designation/birthday.
  dateOfJoining         DateTime?   @db.Date
  avatarDataUrl         String?     @db.LongText
  role                  Role        @default(DEPARTMENT_USER)
  departmentId          String?
  department            Department? @relation(fields: [departmentId], references: [id])
  // Admin of their own department (departmentId above) — can grant module
  // permissions to anyone else in that same department, but not change
  // anyone's role/department or create more department admins. Settable by
  // a company Admin/Super Admin only, via Admin > Users.
  isDepartmentAdmin     Boolean     @default(false)
  isActive              Boolean     @default(true)
  // A snapshot of departmentId (plain string, no relation — it's a memory
  // of the past, not a live link) taken when blocking removes someone from
  // their department, so unblocking can restore it. Department-admin status
  // is never restored this way, even if it's still set when this is read —
  // that has to be re-granted deliberately. Cleared once consumed.
  previousDepartmentId  String?
  resetCode             String? // bcrypt hash of the email login/reset code
  resetCodeExpiresAt    DateTime?
  // Alternate sign-in: mobile number + 6-digit PIN, alongside email+password.
  // Never required — null until the user (or an admin) sets one.
  pinHash               String? // bcrypt hash of the 6-digit PIN
  pinResetCode          String? // bcrypt hash of the mobile-based PIN-reset OTP
  pinResetCodeExpiresAt DateTime?

  // Preferences
  // Fixed app-wide (Asia/Kolkata), not user-editable. Left nullable on purpose:
  // making it required would fail db push against rows that predate the column,
  // and db push runs during the build — a failed push blocks the deploy.
  timezone           String? @default("Asia/Kolkata")
  locale             String  @default("en")
  defaultLandingPage String? // e.g. "/leads" — null means the Dashboard default
  density            String  @default("comfortable") // "comfortable" | "compact"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitesSent       Invite[]                 @relation("InvitedBy")
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  sessions          Session[]

  leadsCreated   Lead[]         @relation("LeadCreatedBy")
  leadsAssigned  Lead[]         @relation("LeadAssignedTo")
  leadsDeleted   Lead[]         @relation("LeadDeletedBy")
  leadNotes      LeadNote[]
  leadActivities LeadActivity[]
  leadReminders  LeadReminder[]

  tasksCreated    Task[]           @relation("TaskCreatedBy")
  tasksAssigned   Task[]           @relation("TaskAssignedTo")
  tasksAssignedTo Task[]           @relation("TaskAssignees")
  tasksDeleted    Task[]           @relation("TaskDeletedBy")
  taskComments    TaskComment[]
  taskAttachments TaskAttachment[]

  projectsCreated        Project[]          @relation("ProjectCreatedBy")
  projectsAssigned       Project[]          @relation("ProjectAssignedTo")
  projectsAssignedTo     Project[]          @relation("ProjectAssignees")
  projectsDeleted        Project[]          @relation("ProjectDeletedBy")
  projectMemberships     ProjectMember[]
  projectDocuments       ProjectDocument[]
  projectActivities      ProjectActivity[]
  projectTasksAssigned   ProjectTask[]      @relation("ProjectTaskAssignedTo")
  projectTasksAssignedBy ProjectTask[]      @relation("ProjectTaskAssignedBy")
  projectTasksCreated    ProjectTask[]      @relation("ProjectTaskCreatedBy")
  projectSupporting      ProjectSupporter[] @relation("ProjectSupporter")
  projectTimeEntries     ProjectTimeEntry[] @relation("ProjectTimeEntryUser")
  projectTimeLogged      ProjectTimeEntry[] @relation("ProjectTimeEntryCreatedBy")

  quotationsCreated  Quotation[]         @relation("QuotationCreatedBy")
  quotationsDeleted  Quotation[]         @relation("QuotationDeletedBy")
  quotationApprovals QuotationApproval[]

  invoicesCreated  Invoice[] @relation("InvoiceCreatedBy")
  invoicesDeleted  Invoice[] @relation("InvoiceDeletedBy")
  paymentsRecorded Payment[]

  leaves                UserLeave[]            @relation("UserLeaves")
  leaveRequests         LeaveRequest[]         @relation("LeaveRequestUser")
  leaveDecisions        LeaveRequest[]         @relation("LeaveRequestDecider")
  expenses              Expense[]              @relation("ExpenseUser")
  expenseDecisions      Expense[]              @relation("ExpenseDecider")
  clientsCreated        Client[]               @relation("ClientCreatedBy")
  formsCreated          Form[]                 @relation("FormCreatedBy")
  clientTeamRoles       ClientTeamMember[]     @relation("ClientTeamMemberUser")
  birthdayGifts         BirthdayGift[]         @relation("BirthdayGiftFor")
  birthdayGiftReminders BirthdayGiftReminder[]
  birthdayWishesSent    BirthdayWishSent[]
  attendance            Attendance[]           @relation("AttendanceUser")
  attendanceApproved    Attendance[]           @relation("AttendanceApprover")
  attendanceAudits      AttendanceAudit[]      @relation("AttendanceAuditActor")

  meetingsOrganized Meeting[] @relation("MeetingOrganizer")
  meetingsAttending Meeting[] @relation("MeetingAttendees")
  meetingsDeleted   Meeting[] @relation("MeetingDeletedBy")

  conversationsCreated    Conversation[]       @relation("ConversationCreatedBy")
  conversationMemberships ConversationMember[]
  messagesSent            Message[]            @relation("MessageSender")
  messageReactions        MessageReaction[]    @relation("MessageReactionUser")
  pushSubscriptions       PushSubscription[]
  auditLogs               AuditLog[]           @relation("AuditActor")

  modulePermissions                UserModulePermission[]
  teamMemberships                  TeamMember[]
  crmMembership                    CrmMember?
  callsOwned                       Call[]                      @relation("CallOwner")
  callsCreated                     Call[]                      @relation("CallCreatedBy")
  callsDeleted                     Call[]                      @relation("CallDeletedBy")
  socialClientsCreated             SocialClient[]              @relation("SocialClientCreatedBy")
  socialClientsAssigned            SocialClient[]              @relation("SocialClientAssignedTo")
  socialContentCreated             SocialContentItem[]         @relation("SocialContentCreatedBy")
  socialContentUpdated             SocialContentItem[]         @relation("SocialContentUpdatedBy")
  socialContentApprovals           SocialContentApproval[]
  socialAdsCreated                 SocialAdCampaign[]          @relation("SocialAdCreatedBy")
  socialAdsUpdated                 SocialAdCampaign[]          @relation("SocialAdUpdatedBy")
  socialReportsCreated             SocialMonthlyReport[]       @relation("SocialReportCreatedBy")
  socialReportsUpdated             SocialMonthlyReport[]       @relation("SocialReportUpdatedBy")
  socialReportFilesUploaded        SocialReportFile[]          @relation("SocialReportFileUploadedBy")
  socialClientActivities           SocialClientActivity[]
  socialPlatformsCreated           SocialPlatformAccount[]     @relation("SocialPlatformCreatedBy")
  socialPlatformsUpdated           SocialPlatformAccount[]     @relation("SocialPlatformUpdatedBy")
  socialPlatformCredentialsUpdated SocialPlatformAccount[]     @relation("SocialPlatformCredentialsUpdatedBy")
  socialCalendarSlotsCreated       SocialContentCalendarSlot[] @relation("SocialCalendarSlotCreatedBy")
  socialClientFoldersCreated       SocialClientFolder[]        @relation("SocialClientFolderCreatedBy")
  socialClientImagesUploaded       SocialClientImage[]         @relation("SocialClientImageUploadedBy")
  passwordEntriesCreated           PasswordEntry[]             @relation("PasswordEntryCreatedBy")
  passwordEntriesUpdated           PasswordEntry[]             @relation("PasswordEntryUpdatedBy")
  passwordSharesReceived           PasswordEntryShare[]        @relation("PasswordEntrySharedWith")
  passwordSharesGiven              PasswordEntryShare[]        @relation("PasswordEntrySharedBy")
  passwordEntryActivities          PasswordEntryActivity[]
  notesCreated                     Note[]                      @relation("NoteAuthor")
  notesDeleted                     Note[]                      @relation("NoteDeletedBy")
}

/// A browser/device push endpoint, so a user can be notified about a new
/// message while the app is closed. One row per device — the same person on a
/// phone and a laptop has two, and each can expire independently.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The push service URL. Unique because re-subscribing on the same device
  /// returns the same endpoint, and we want an upsert rather than a duplicate.
  /// VarChar, not Text: MySQL can't build a unique index on TEXT without a
  /// prefix length, and 500 stays under InnoDB's 3072-byte key limit.
  endpoint String @unique @db.VarChar(500)
  p256dh   String @db.Text
  auth     String @db.Text

  /// Labels the row in Settings so a user can tell their devices apart.
  userAgent  String?   @db.Text
  createdAt  DateTime  @default(now())
  /// Cleared out when the push service reports the endpoint is dead (404/410).
  lastUsedAt DateTime?

  @@index([userId])
}

model Invite {
  id                       String      @id @default(cuid())
  email                    String
  role                     Role
  departmentId             String?
  department               Department? @relation(fields: [departmentId], references: [id])
  /// "Social Media Lead" in the invite Role picker isn't a real company
  /// Role — the account is still created as DEPARTMENT_USER, this just tells
  /// acceptance to also provision a Social Media TeamMember(isLead: true) row,
  /// so full social-media access is granted the moment they accept rather
  /// than needing a separate admin step afterward.
  socialMediaAdmin         Boolean     @default(false)
  /// Same idea as socialMediaAdmin, but for a regular (non-lead) team member —
  /// provisions a Social Media TeamMember(isLead: false) on acceptance instead.
  /// Mutually exclusive with socialMediaAdmin in practice, not enforced here.
  socialMediaMember        Boolean     @default(false)
  /// Same idea as socialMediaAdmin/socialMediaMember, but provisions a CRM
  /// TeamMember row on acceptance instead — the CRM Team's equivalent.
  crmAdmin                 Boolean     @default(false)
  crmMember                Boolean     @default(false)
  /// Same idea as socialMediaAdmin/socialMediaMember/crmAdmin/crmMember, but
  /// for any other (non-system) team — provisions a TeamMember row on this
  /// team on acceptance, isLead per `teamIsLead`. Null for every invite not
  /// created from a custom team's own console.
  teamId                   String?
  team                     Team?       @relation(fields: [teamId], references: [id])
  teamIsLead               Boolean     @default(false)
  /// Grants Department Admin (see User.isDepartmentAdmin) for `departmentId`
  /// the moment this invite is accepted. Only a company Admin/Super Admin
  /// can set this when creating the invite — a Department Admin inviting
  /// into their own department can't mint another one.
  inviteeIsDepartmentAdmin Boolean     @default(false)
  token                    String      @unique
  invitedById              String
  invitedBy                User        @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt                DateTime
  acceptedAt               DateTime?
  createdAt                DateTime    @default(now())

  @@index([email])
  @@index([teamId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/**
 * Per-user, per-category in-app notification toggle. Missing row = enabled (default-on).
 */
model NotificationPreference {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String // "leads" | "tasks" | "projects" | "quotations"
  inApp    Boolean @default(true)

  @@unique([userId, category])
}

/**
 * A logged-in session/device. The JWT carries this row's id as its `sid` claim,
 * so revoking here (revokedAt) invalidates that cookie immediately, even before
 * it expires — otherwise a JWT has no server-side kill switch.
 */
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

// ---------- Leads ----------

enum LeadStatus {
  NEW
  CONTACTED
  /// Social Media's custom pipeline only (see SOCIAL_MEDIA_LEAD_STATUSES in
  /// src/components/leads/types.ts) — other departments never see or pick
  /// this value, but it lives in the same shared Lead table/enum as everyone
  /// else's leads.
  MEETING
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MeetingStatus {
  SCHEDULED
  DUE
  COMPLETED
}

model Lead {
  id                  String         @id @default(cuid())
  name                String
  company             String?
  email               String?
  phone               String?
  source              String?
  product             String?
  priority            Priority       @default(MEDIUM)
  status              LeadStatus     @default(NEW)
  leadArriveDate      DateTime?
  meetingDate         DateTime?
  meetingStatus       MeetingStatus?
  assignedToId        String?
  assignedTo          User?          @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  departmentId        String?
  department          Department?    @relation(fields: [departmentId], references: [id])
  createdById         String
  createdBy           User           @relation("LeadCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  /// Set once, the first time a Social Media team member moves this lead to
  /// "Approval" (WON) — auto-creates a SocialClient and records its id here
  /// so re-saving the same status never creates a second client. Not a
  /// Prisma relation on purpose: Lead and SocialClient are otherwise
  /// unrelated domains, this is just a soft pointer for the redirect/link.
  convertedToClientId String?

  /// Soft delete for the Trash module — null means active. A deleted lead is
  /// never actually removed (every relation below stays intact for an exact
  /// recovery); it's just excluded from the normal list/search/detail
  /// queries until either restored or purged 30 days after deletedAt.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("LeadDeletedBy", fields: [deletedById], references: [id])

  notes      LeadNote[]
  activities LeadActivity[]
  reminders  LeadReminder[]
  quotations Quotation[]
  calls      Call[]

  @@index([status])
  @@index([departmentId])
  @@index([assignedToId])
  @@index([deletedAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  meta      Json?
  createdAt DateTime @default(now())
}

model LeadReminder {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dueAt       DateTime
  note        String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

// ---------- Tasks ----------

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

model Task {
  id                  String       @id @default(cuid())
  title               String
  description         String?      @db.Text
  status              TaskStatus   @default(TODO)
  priority            Priority     @default(MEDIUM)
  dueDate             DateTime?
  /// The primary assignee — kept in sync as the first entry of `assignees`
  /// below (set/cleared together), so every existing single-assignee reader
  /// (reminders, the dashboard's "my tasks" widget, the activity feed, a
  /// ProjectTask mirroring into its linked Task) keeps working unchanged.
  /// `assignees` is the source of truth for "who can see/act on this" and
  /// for notifications; this scalar is a read convenience, not a second
  /// independent assignment.
  assignedToId        String?
  assignedTo          User?        @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  /// Everyone this task is assigned to — may be empty, one, or several.
  assignees           User[]       @relation("TaskAssignees")
  createdById         String
  createdBy           User         @relation("TaskCreatedBy", fields: [createdById], references: [id])
  projectTaskParentId String?      @unique
  projectTaskParent   ProjectTask? @relation(fields: [projectTaskParentId], references: [id])
  /// When set, a cron-driven route notifies whoever this task is assigned to
  /// (toast/bell + OS push) once this time passes — see send-reminders/route.ts.
  /// Independent of dueDate — a reminder isn't required to line up with it.
  remindAt            DateTime?
  /// Set once the reminder actually fires, so the cron never re-sends the
  /// same one. Cleared automatically if remindAt is changed to a new value.
  reminderSentAt      DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  /// Soft delete for the Trash module — see Lead.deletedAt for the full reasoning.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("TaskDeletedBy", fields: [deletedById], references: [id])

  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([status])
  @@index([assignedToId])
  @@index([remindAt])
  @@index([deletedAt])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  data         String?  @db.LongText // base64-encoded file bytes stored in MySQL
  /// Set when this is a link rather than an uploaded file; `data` is then null
  /// and `fileName` holds the label. An explicit column rather than sniffing
  /// filePath for "http", so the two kinds can never be confused.
  url          String?  @db.Text
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

// ---------- Projects ----------

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id           String        @id @default(cuid())
  name         String
  description  String?       @db.Text
  departmentId String
  department   Department    @relation(fields: [departmentId], references: [id])
  status       ProjectStatus @default(PLANNED)
  progress     Int           @default(0)
  isActive     Boolean       @default(true)
  startDate    DateTime?
  endDate      DateTime?
  createdById  String
  createdBy    User          @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  /// The primary assignee — kept in sync as the first entry of `assignees`
  /// below. See Task.assignedToId's comment for why this scalar stays
  /// alongside the relation rather than being replaced by it.
  assignedToId String?
  assignedTo   User?         @relation("ProjectAssignedTo", fields: [assignedToId], references: [id])
  /// Everyone this project is assigned to — may be empty, one, or several.
  /// Distinct from `members` (the project's whole team/roster): every
  /// assignee is force-added as a member, but not every member is an
  /// assignee.
  assignees    User[]        @relation("ProjectAssignees")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  /// Hours the project was budgeted for, so logged time can be read against a
  /// plan rather than in isolation. Optional — a project may have no estimate.
  estimatedHours Int?

  members     ProjectMember[]
  supporters  ProjectSupporter[]
  timeEntries ProjectTimeEntry[]
  milestones  Milestone[]
  tasks       ProjectTask[]
  documents   ProjectDocument[]
  activities  ProjectActivity[]

  /// Soft delete for the Trash module — see Lead.deletedAt for the full reasoning.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("ProjectDeletedBy", fields: [deletedById], references: [id])

  @@index([departmentId])
  @@index([status])
  @@index([deletedAt])
}

/// Someone who contributes to a project without being on its team: a reviewer,
/// a specialist pulled in for a week, another department's lead. Kept separate
/// from ProjectMember so team headcount and access rules stay unaffected.
model ProjectSupporter {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ProjectSupporter", fields: [userId], references: [id])
  /// What they support with, e.g. "Security review". Free text, not a role enum.
  role      String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
}

/// One person's work on one day. Stored per day rather than as start/stop
/// timestamps: the CRM records effort after the fact, and a day is the unit
/// people actually report in.
model ProjectTimeEntry {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("ProjectTimeEntryUser", fields: [userId], references: [id])
  /// Date-only: two entries on the same day are separate rows, not merged, so
  /// their descriptions survive.
  workDate    DateTime @db.Date
  /// Minutes, not fractional hours — decimal hours accumulate rounding error
  /// across a sum, and "1h 20m" has no exact float representation.
  minutes     Int
  description String?  @db.Text
  createdById String
  createdBy   User     @relation("ProjectTimeEntryCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, workDate])
  @@index([userId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

enum MilestoneStatus {
  PENDING
  WORKING
  DONE
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime?
  status      MilestoneStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  tasks ProjectTask[]
}

model ProjectTask {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId  String?
  milestone    Milestone?    @relation(fields: [milestoneId], references: [id])
  title        String
  description  String?       @db.Text
  status       TaskStatus    @default(TODO)
  dueDate      DateTime?
  progressPct  Int           @default(0)
  assignedToId String?
  assignedTo   User?         @relation("ProjectTaskAssignedTo", fields: [assignedToId], references: [id])
  /// Who the work is attributed to as having assigned it. Defaults to whoever
  /// filled the form, but is editable: an admin often raises a task on a
  /// manager's behalf, and the manager is the one who actually assigned it.
  assignedById String?
  assignedBy   User?         @relation("ProjectTaskAssignedBy", fields: [assignedById], references: [id])
  /// Who actually submitted the form. Never editable, so changing `assignedBy`
  /// can't erase the record of who really created the task. Nullable only
  /// because tasks predating this field have no one to credit.
  createdById  String?
  createdBy    User?         @relation("ProjectTaskCreatedBy", fields: [createdById], references: [id])
  parentTaskId String?
  parentTask   ProjectTask?  @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks     ProjectTask[] @relation("SubTasks")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  linkedTask Task?
  dependsOn  ProjectTaskDependency[] @relation("DependentTask")
  dependents ProjectTaskDependency[] @relation("DependsOnTask")

  @@index([projectId])
  @@index([status])
  @@index([assignedToId])
}

model ProjectTaskDependency {
  id            String      @id @default(cuid())
  taskId        String
  task          ProjectTask @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId   String
  dependsOnTask ProjectTask @relation("DependsOnTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

model ProjectDocument {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  data         String?  @db.LongText // base64-encoded file bytes stored in MySQL
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model ProjectActivity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  meta      Json?
  createdAt DateTime @default(now())
}

// ---------- Quotations ----------

